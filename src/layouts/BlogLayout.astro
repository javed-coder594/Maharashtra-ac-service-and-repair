---
import MainLayout from "./MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
const { title, description } = Astro.props;
---
<MainLayout title={title} description={description}>
<Header />
<main><article class="article"><div class="container article-container">
<a class="back" href="/blog/">← Back to AC Knowledge Hub</a>
<div class="article-shell"><slot /></div>
</div></article></main>
<CTA title="Need AC service or repair?" text="Tell us your Pune or Mumbai locality and AC requirement. Our team is available for service enquiries." />
<Footer />
</MainLayout>
<style>
.article{padding:72px 0 88px;background:linear-gradient(180deg,#f0f6fa 0,#fff 300px)}.article-container{max-width:980px}.back{display:inline-flex;align-items:center;color:var(--orange-dark);font-weight:850;margin-bottom:24px}.article-shell{background:#fff;border:1px solid var(--border);border-radius:26px;padding:52px;box-shadow:0 20px 55px rgba(35,73,110,.10)}.article-shell :global(.article-head h1){font-size:clamp(2.3rem,5vw,4.15rem);max-width:850px;margin-top:12px}.article-shell :global(.post-meta){color:var(--muted);font-size:.86rem;border-bottom:1px solid var(--border);padding-bottom:22px;margin-bottom:30px}.article-shell :global(.featured-image){width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:20px;margin:0 0 34px;border:1px solid #cad9e5;box-shadow:0 18px 45px rgba(23,59,99,.12)}.article-shell :global(.post-content){font-size:1.04rem}.article-shell :global(.post-content h2){font-size:1.8rem;margin-top:44px}.article-shell :global(.post-content h3){margin-top:30px}.article-shell :global(.post-content ul),.article-shell :global(.post-content ol){padding-left:24px;color:var(--muted)}.article-shell :global(.post-content li){margin-bottom:8px}.article-shell :global(.post-content a){color:var(--orange-dark);font-weight:750}.article-shell :global(blockquote){border-left:4px solid var(--orange);margin:30px 0;padding:14px 20px;background:var(--surface);border-radius:0 12px 12px 0}.article-shell :global(hr){border:0;border-top:1px solid var(--border);margin:36px 0}.article-shell :global(.article-cta){margin-top:42px;padding:26px;border-radius:18px;background:linear-gradient(135deg,#071f43,#124b7f);color:#fff}.article-shell :global(.article-cta h2){color:#fff;margin-top:0}.article-shell :global(.article-cta p){color:#d5e2ef}.article-shell :global(.article-cta a){color:#ffad67}@media(max-width:650px){.article{padding:48px 0 65px}.article-shell{padding:28px 20px;border-radius:18px}}
</style>