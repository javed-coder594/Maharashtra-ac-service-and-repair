---
import MainLayout from "./MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
const { title, description } = Astro.props;
---
<MainLayout title={title} description={description}>
<Header />
<main><article class="article"><div class="container article-container">
<a class="back" href="/blog/">← Back to AC Knowledge Hub</a>
<div class="article-shell"><slot /></div>
</div></article></main>
<CTA title="Need AC service or repair?" text="Tell us your Pune or Mumbai locality and AC requirement. Our team is available for service enquiries." />
<Footer />
</MainLayout>
<style>
.article{padding:72px 0 88px;background:radial-gradient(ellipse at 50% 0%,rgba(11,79,108,.09),transparent 42%),linear-gradient(180deg,#f0f6fa 0,#fff 360px)}
.article-container{max-width:1020px}
.back{display:inline-flex;align-items:center;color:var(--orange-dark);font-weight:850;margin-bottom:24px;gap:8px;transition:transform .2s ease,color .2s ease}
.back:hover{transform:translateX(-3px);color:var(--navy)}
.article-shell{background:#fff;border:1px solid #e1eaf0;border-radius:26px;padding:clamp(26px,5vw,54px);box-shadow:0 22px 65px rgba(23,59,99,.09)}
.article-shell :global(.article-head){position:relative;padding-bottom:4px}
.article-shell :global(.article-head h1){font-size:clamp(2.25rem,5vw,4rem);line-height:1.12;letter-spacing:-.045em;color:#0b344d;max-width:850px;margin-top:14px;margin-bottom:18px;text-wrap:balance}
.article-shell :global(.eyebrow){padding:7px 11px;border-radius:999px;background:#fff3e9;color:#a94f16;letter-spacing:.075em}
.article-shell :global(.eyebrow:before){display:none}
.article-shell :global(.post-meta){display:flex;flex-wrap:wrap;gap:6px;color:#627488;font-size:.84rem;border-bottom:1px solid #e6edf2;padding-bottom:24px;margin-bottom:30px}
.article-shell :global(.featured-image){width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:20px;margin:0 0 34px;border:1px solid #cad9e5;box-shadow:0 18px 45px rgba(23,59,99,.12)}
.article-shell :global(.post-content){font-size:1.04rem;line-height:1.82;color:#34475a;max-width:790px;margin-inline:auto}
.article-shell :global(.post-content > p:first-child){font-size:1.12rem;line-height:1.85;color:#243d52}
.article-shell :global(.post-content h2){position:relative;font-size:clamp(1.55rem,3vw,1.95rem);line-height:1.28;letter-spacing:-.025em;color:#0b344d;margin-top:52px;margin-bottom:18px;padding:3px 0 4px 16px;border-left:4px solid #e88742;scroll-margin-top:100px}
.article-shell :global(.post-content h3){font-size:1.22rem;line-height:1.4;letter-spacing:-.012em;color:#125c7a;margin-top:30px;margin-bottom:10px}
.article-shell :global(.post-content p){margin:0 0 18px}
.article-shell :global(.post-content strong){color:#16364c;font-weight:800}
.article-shell :global(.post-content ul),.article-shell :global(.post-content ol){padding:18px 22px 18px 42px;margin:18px 0 24px;background:#f5f9fb;border:1px solid #e6eef3;border-radius:14px;color:#34475a}
.article-shell :global(.post-content li){margin-bottom:9px;padding-left:3px}
.article-shell :global(.post-content li:last-child){margin-bottom:0}
.article-shell :global(.post-content li::marker){color:#d97732;font-weight:800}
.article-shell :global(.post-content a){color:#a94f16;font-weight:750;text-decoration-thickness:1px;text-underline-offset:3px}
.article-shell :global(.post-content a:hover){color:#0b5b78}
.article-shell :global(.post-content h2:first-of-type){margin-top:28px}
.article-shell :global(.post-content h2:first-of-type + p){background:linear-gradient(135deg,#eef7fb,#f7fafc);border:1px solid #d8eaf2;border-left:4px solid #0b7898;border-radius:0 14px 14px 0;padding:20px 22px;color:#193e53;box-shadow:0 7px 20px rgba(23,59,99,.045)}
.article-shell :global(blockquote){border-left:4px solid #e88742;margin:28px 0;padding:18px 22px;background:#fff7f0;border-radius:0 14px 14px 0;color:#5d4a3b}
.article-shell :global(hr){border:0;border-top:1px solid #e1eaf0;margin:40px 0}
.article-shell :global(.article-cta){margin-top:42px;padding:26px;border-radius:18px;background:linear-gradient(135deg,#071f43,#124b7f);color:#fff}
.article-shell :global(.article-cta h2){color:#fff;margin-top:0}
.article-shell :global(.article-cta p){color:#d5e2ef}
.article-shell :global(.article-cta a){color:#ffad67}
@media(max-width:650px){
.article{padding:42px 0 60px}
.article-shell{padding:25px 19px;border-radius:18px}
.article-shell :global(.post-content){font-size:1rem;line-height:1.78}
.article-shell :global(.post-content > p:first-child){font-size:1.04rem}
.article-shell :global(.post-content h2){margin-top:40px}
.article-shell :global(.post-content ul),.article-shell :global(.post-content ol){padding:16px 16px 16px 34px}
}
@media(prefers-reduced-motion:reduce){.back{transition:none}}
</style>