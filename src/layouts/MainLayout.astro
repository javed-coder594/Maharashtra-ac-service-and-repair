---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
interface Props { title:string; description?:string; canonical?:string; image?:string; }
const { title, description="Professional AC service and repair across Pune and Mumbai.", canonical, image="/og-default.svg" } = Astro.props;
const canonicalUrl=canonical??Astro.url.href;
const absoluteImage=new URL(image, Astro.site??Astro.url).href;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#071f43" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteImage} />
    <title>{title}</title><Font cssVariable="--font-manrope" preload /><ClientRouter fallback="animate" />
  </head>
  <body>
    <slot />
    <a class="whatsapp-float" href="https://wa.me/917378351743?text=Hello%20Maharashtra%20AC%20Service%20%26%20Repair%2C%20I%20need%20AC%20service." target="_blank" rel="noopener noreferrer" aria-label="Chat with Maharashtra AC Service & Repair on WhatsApp">
      <span class="whatsapp-icon" aria-hidden="true">⌕</span><span class="whatsapp-label">WhatsApp</span>
    </a>
  </body>
</html>
<style>
.whatsapp-float{position:fixed;right:22px;bottom:22px;z-index:100;display:flex;align-items:center;gap:9px;padding:12px 16px;border-radius:999px;background:#25d366;color:#fff;font-weight:850;box-shadow:0 14px 30px rgba(0,0,0,.2);transition:transform .25s ease,box-shadow .25s ease,filter .25s ease}.whatsapp-float:hover{transform:translateY(-4px);box-shadow:0 20px 38px rgba(0,0,0,.25);filter:saturate(1.08)}.whatsapp-icon{width:25px;height:25px;border:2px solid rgba(255,255,255,.85);border-radius:50%;display:grid;place-items:center;font-size:1rem}.whatsapp-label{font-size:.82rem}@media(max-width:520px){.whatsapp-float{right:14px;bottom:14px;padding:12px}.whatsapp-label{display:none}}
</style>