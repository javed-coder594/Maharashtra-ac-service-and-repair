---
import "../styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
interface Props { title:string; description?:string; canonical?:string; image?:string; }
const { title, description="Professional AC service and repair across Pune and Mumbai.", canonical, image="/og-default.svg" } = Astro.props;
const siteUrl = (Astro.site?.toString() ?? "https://maharashtraacservice.com").replace(/\/$/, "");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Maharashtra AC Service & Repair",
      "url": `${siteUrl}/`,
      "telephone": "+91-73783-51743",
      "areaServed": [
        { "@type": "City", "name": "Pune", "containedInPlace": { "@type": "State", "name": "Maharashtra" } },
        { "@type": "City", "name": "Mumbai", "containedInPlace": { "@type": "State", "name": "Maharashtra" } }
      ]
    },
    { "@type": "WebSite", "@id": `${siteUrl}/#website`, "url": `${siteUrl}/`, "name": "Maharashtra AC Service & Repair", "publisher": { "@id": `${siteUrl}/#organization` }, "inLanguage": "en-IN" }
  ]
};
const absoluteImage=new URL(image, Astro.site??Astro.url).href;
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
<meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} /><link rel="describedby" href="/llms.txt" type="text/markdown" />
<meta name="theme-color" content="#f7fafc" />
<link rel="icon" type="image/png" href="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/55a51d7a-cab0-4a0b-9d27-a2bba7da2f8d" />
<link rel="shortcut icon" href="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/55a51d7a-cab0-4a0b-9d27-a2bba7da2f8d" />
<link rel="apple-touch-icon" href="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/55a51d7a-cab0-4a0b-9d27-a2bba7da2f8d" />
<meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={absoluteImage} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={absoluteImage} />
<title>{title}</title><Font cssVariable="--font-manrope" preload /><ClientRouter fallback="animate" />
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body>
<slot />
<a class="call-float" href="tel:+917378351743" aria-label="Call Maharashtra AC Service & Repair">
<span class="call-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M5 4.8 8.2 4l2 4.5-2.1 1.7a15 15 0 0 0 5.7 5.7l1.7-2.1 4.5 2-.8 3.2a2 2 0 0 1-2.2 1.5A17.5 17.5 0 0 1 3.5 7a2 2 0 0 1 1.5-2.2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="call-label">Call Now</span>
</a>
<a class="whatsapp-float" href="https://wa.me/917378351743?text=Hello%20Maharashtra%20AC%20Service%20%26%20Repair%2C%20I%20need%20AC%20service." target="_blank" rel="noopener noreferrer" aria-label="Chat with Maharashtra AC Service & Repair on WhatsApp">
<span class="whatsapp-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="23" height="23" fill="none"><path d="M20.2 11.7a8.2 8.2 0 0 1-12.1 7.2L4 20l1.1-4a8.2 8.2 0 1 1 15.1-4.3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.6 8.1c.2-.5.4-.5.7-.5h.5c.2 0 .3.1.4.4l.7 1.7c.1.2.1.4-.1.6l-.5.6c-.2.2-.2.3 0 .6.4.7 1 1.3 1.7 1.7.3.2.4.2.6 0l.7-.8c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .3-.2 1.2-.7 1.6-.5.4-1.1.6-1.8.4-1.1-.3-2.4-.9-3.6-2.1-1.1-1.1-1.8-2.5-2-3.4-.2-.8.2-1.5.8-1.9Z" fill="currentColor"/></svg></span><span class="whatsapp-label">WhatsApp</span>
</a>
</body>
</html>
<style>
.call-float,.whatsapp-float{position:fixed;bottom:24px;z-index:100;display:flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 21px;border:1px solid rgba(255,255,255,.2);border-radius:18px;color:#fff;font-weight:850;letter-spacing:.01em;box-shadow:0 12px 28px rgba(10,31,57,.22),inset 0 1px 0 rgba(255,255,255,.22);transition:transform .22s ease,box-shadow .22s ease,filter .22s ease}
.call-float{left:22px;background:linear-gradient(135deg,#2378f6,#1555d6);box-shadow:0 12px 28px rgba(21,85,214,.3),inset 0 1px 0 rgba(255,255,255,.22)}
.whatsapp-float{right:22px;background:linear-gradient(135deg,#2bd66f,#16a34a);box-shadow:0 12px 28px rgba(22,163,74,.28),inset 0 1px 0 rgba(255,255,255,.22)}
.call-float:hover,.whatsapp-float:hover{transform:translateY(-4px);filter:saturate(1.12);box-shadow:0 18px 36px rgba(10,31,57,.26)}
.call-icon,.whatsapp-icon{width:28px;height:28px;display:grid;place-items:center;flex:0 0 28px}
.call-icon svg,.whatsapp-icon svg{display:block;width:24px;height:24px}
.call-label,.whatsapp-label{font-size:.9rem}
@media(max-width:520px){.call-float,.whatsapp-float{bottom:15px;min-height:54px;padding:0 15px;border-radius:17px;gap:7px}.call-float{left:14px}.whatsapp-float{right:14px}.call-label,.whatsapp-label{display:inline;font-size:.82rem}.call-icon,.whatsapp-icon{width:24px;height:24px;flex-basis:24px}.call-icon svg,.whatsapp-icon svg{width:22px;height:22px}}
@media(prefers-reduced-motion:reduce){.call-float,.whatsapp-float{transition:none}}
</style>