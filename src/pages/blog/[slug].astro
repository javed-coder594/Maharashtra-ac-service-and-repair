---
import BlogLayout from "../../layouts/BlogLayout.astro";
export function getStaticPaths() {
  const posts = import.meta.glob("../../content/blog/*.md", { eager: true });
  return Object.entries(posts).map(([path, module]: any) => {
    const slug = path.split("/").pop()?.replace(".md", "") ?? "";
    return { params: { slug }, props: { post: module } };
  });
}
const { post } = Astro.props;
const Content = post.default;
const meta = post.frontmatter;
---
<BlogLayout title={meta.metaTitle || meta.title} description={meta.metaDescription || meta.description}>
  <header class="article-head">
    <span class="eyebrow">{meta.category}</span>
    <h1>{meta.title}</h1>
    <p class="post-meta">Published {meta.date} · {meta.author} · {meta.readTime}</p>
  </header>
  {meta.image && <figure class="featured-figure">
    <img class="featured-image" src={meta.image} alt={meta.imageAlt || meta.title} width="1600" height="900" fetchpriority="high" decoding="async" />
  </figure>}
  <div class="post-content"><Content /></div>
</BlogLayout>
<style>
.article-head :global(h1){margin-top:12px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--orange);font-size:.78rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
.eyebrow:before{content:"";width:28px;height:2px;background:currentColor}
.featured-figure{margin:0 0 34px}
.featured-figure :global(.featured-image){display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:20px;border:1px solid #cad9e5;box-shadow:0 18px 45px rgba(23,59,99,.12)}
/* Consistent, responsive table design for every blog article */
.post-content :global(table){display:block;width:100%;max-width:100%;overflow-x:auto;border-collapse:separate;border-spacing:0;margin:26px 0 32px;border:1px solid #dce6ee;border-radius:14px;background:#fff;box-shadow:0 8px 24px rgba(23,59,99,.07);font-size:.94rem;line-height:1.6;overscroll-behavior-x:contain}
.post-content :global(thead){background:#0b344d;color:#fff}
.post-content :global(th){padding:15px 18px;text-align:left;font-weight:750;white-space:normal;border-bottom:1px solid #dce6ee}
.post-content :global(td){padding:14px 18px;text-align:left;vertical-align:top;border-bottom:1px solid #e8eef3;color:#34475a;min-width:145px}
.post-content :global(tbody tr:nth-child(even)){background:#f3f7fa}
.post-content :global(tbody tr:hover){background:#eaf4f8}
.post-content :global(tbody tr:last-child td){border-bottom:0}
.post-content :global(th:first-child){border-top-left-radius:13px}
.post-content :global(th:last-child){border-top-right-radius:13px}
@media(max-width:650px){.post-content :global(table){font-size:.87rem;margin:20px 0 26px}.post-content :global(th),.post-content :global(td){padding:12px 14px;min-width:135px}}
</style>