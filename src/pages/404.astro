---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<MainLayout title="Page Not Found | Maharashtra AC Service & Repair">
<Header /><main class="not-found"><div class="container"><span class="code">404</span><span class="eyebrow">Oops, wrong turn</span><h1>This page is not available.</h1><p>The page may have moved, but you can head back home or explore our AC services.</p><div class="actions"><a class="btn btn--primary" href="/">Back to Home</a><a class="btn btn--secondary" href="/services/">View Services</a></div></div></main><Footer /></MainLayout>
<style>
.not-found{min-height:65vh;display:grid;place-items:center;text-align:center;padding:90px 0;background:radial-gradient(circle at 50% 30%,#eaf5ff,transparent 32%),#fff}.not-found .container{max-width:720px}.code{display:block;font-size:clamp(5rem,15vw,9rem);font-weight:950;line-height:.85;color:var(--orange);letter-spacing:-.08em;margin-bottom:28px}.not-found h1{margin-top:12px}.not-found p{max-width:560px;margin:0 auto 25px}.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
</style>