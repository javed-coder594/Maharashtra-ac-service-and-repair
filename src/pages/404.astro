---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<MainLayout title="Page Not Found | Maharashtra AC Service & Repair"><Header /><main class="not-found"><div class="container"><span class="code">404</span><h1>Page not found</h1><p>The page you are looking for does not exist or may have moved.</p><a class="btn btn--primary" href="/">Back to Home</a></div></main><Footer /></MainLayout>
<style>.not-found{min-height:60vh;display:grid;place-items:center;text-align:center;padding:80px 0}.code{font-size:5rem;font-weight:900;color:var(--orange)}.not-found p{margin-bottom:25px}</style>