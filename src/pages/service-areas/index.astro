---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="Service Areas | Pune & Mumbai AC Service" description="Find AC service and repair information for Pune and Mumbai, including key Pune and Mumbai localities.">
<Header /><main>
<section class="page-hero"><div class="container"><span class="eyebrow">Service Areas</span><h1>Local AC support across Pune &amp; Mumbai.</h1><p>Choose your city and find useful service information for homes, offices, shops and commercial spaces across key localities.</p></div></section>
<section class="section"><div class="container area-grid"><a class="area-card card" href="/service-areas/pune/"><div class="area-top"><span>01</span><strong>PUNE</strong></div><h2>AC Service in Pune</h2><p>Explore service, repair, installation and maintenance information across Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade.</p><span class="area-link">Explore Pune <b>→</b></span></a><a class="area-card card" href="/service-areas/mumbai/"><div class="area-top"><span>02</span><strong>MUMBAI</strong></div><h2>AC Service in Mumbai</h2><p>Explore Mumbai AC support across Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane.</p><span class="area-link">Explore Mumbai <b>→</b></span></a></div></section>
<section class="section section--soft"><div class="container coverage"><div><span class="eyebrow">Pune Coverage</span><h2>AC service across key Pune areas.</h2><p>Use the Pune page for area-specific information and enquiries.</p></div><div class="area-chips">{["Baner","Balewadi","Hinjawadi","Wakad","Aundh","Pimple Saudagar","Pimple Nilakh","Pimple Gurav","Ravet","Tathawade"].map((area)=><a href="/service-areas/pune/">{area}</a>)}</div></div></section>
<section class="section"><div class="container coverage"><div><span class="eyebrow">Mumbai Coverage</span><h2>AC service across key Mumbai areas.</h2><p>Use the Mumbai page for area-specific information and enquiries.</p></div><div class="area-chips">{["Andheri","Bandra","Powai","Borivali","Kandivali","Malad","Goregaon","Vile Parle","Kurla","Ghatkopar","Chembur","Thane"].map((area)=><a href="/service-areas/mumbai/">{area}</a>)}</div></div></section>
<section class="section section--soft"><div class="container local-info"><div><span class="eyebrow">Local Service</span><h2>Tell us your area when you enquire.</h2><p>Sharing your locality helps make your service enquiry clearer. You can also mention the AC type, the main problem and whether the requirement is service, repair, installation or maintenance.</p></div><div class="contact-box"><strong>73783 51743</strong><span>maharastraavservicerepair15@gmail.com</span><div><a class="btn btn--primary" href="tel:+917378351743">Call Now</a><a class="btn btn--secondary" href="/contact/">Contact Us</a></div></div></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.page-hero{padding:82px 0}.page-hero p{max-width:760px;font-size:1.08rem}.area-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}.area-card{padding:34px;position:relative;overflow:hidden}.area-card:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-85px;bottom:-100px;border:1px solid rgba(35,133,200,.13);box-shadow:0 0 0 30px rgba(35,133,200,.025)}.area-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:35px}.area-top span{color:var(--orange);font-size:.76rem;font-weight:900}.area-top strong{color:#8ea0b1;font-size:.72rem;letter-spacing:.18em}.area-card h2{font-size:2rem}.area-link{display:inline-flex;gap:7px;color:var(--orange-dark);font-weight:850;margin-top:12px}.coverage{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:start}.area-chips{display:flex;flex-wrap:wrap;gap:10px}.area-chips a{padding:12px 16px;border-radius:999px;background:#fff;border:1px solid #cbd9e5;color:var(--navy);font-weight:800;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.area-chips a:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:#9fb8cc}.local-info{display:grid;grid-template-columns:1fr .8fr;gap:60px;align-items:center}.contact-box{padding:30px;background:linear-gradient(145deg,#f0f8fd,#fff);border:1px solid #cbdde9;border-radius:20px;box-shadow:var(--shadow)}.contact-box strong{display:block;color:var(--navy);font-size:1.5rem}.contact-box>span{display:block;color:var(--muted);margin:6px 0 22px;font-size:.9rem}.contact-box div{display:flex;gap:10px;flex-wrap:wrap}@media(max-width:700px){.area-grid,.coverage,.local-info{grid-template-columns:1fr;gap:35px}}
</style>