---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="Service Areas | Pune & Mumbai AC Service" description="Find AC service and repair information for Pune and Mumbai.">
<Header /><main>
<section class="page-hero"><div class="container"><span class="eyebrow">Service Areas</span><h1>Local AC support across Pune &amp; Mumbai.</h1><p>Choose your city for dedicated AC service, repair, installation and maintenance information.</p></div></section>
<section class="section"><div class="container area-grid">
<a class="area-card card" href="/service-areas/pune/"><div class="area-top"><span>01</span><strong>PUNE</strong></div><h2>AC Service in Pune</h2><p>Explore service options and local information for homes and businesses across Pune.</p><span class="area-link">Explore Pune <b>→</b></span></a>
<a class="area-card card" href="/service-areas/mumbai/"><div class="area-top"><span>02</span><strong>MUMBAI</strong></div><h2>AC Service in Mumbai</h2><p>Explore AC service, repair and maintenance support across Mumbai.</p><span class="area-link">Explore Mumbai <b>→</b></span></a>
</div></section>
<section class="section section--soft"><div class="container coverage"><div><span class="eyebrow">Need Help?</span><h2>Not sure which service you need?</h2><p>Call or email us with your AC issue and we can help you choose the right service.</p></div><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call Now</a><a class="btn btn--secondary" href="mailto:maharastraavservicerepair15@gmail.com">Email Us</a></div></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.page-hero{padding:100px 0;background:radial-gradient(circle at 80% 15%,#eaf5ff,transparent 32%),linear-gradient(135deg,#f7f9fc,#fff)}.page-hero p{max-width:700px;font-size:1.08rem}.area-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}.area-card{padding:34px;position:relative;overflow:hidden}.area-card:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-85px;bottom:-100px;border:1px solid rgba(22,119,200,.13);box-shadow:0 0 0 30px rgba(22,119,200,.025)}.area-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:45px}.area-top span{color:var(--orange);font-size:.76rem;font-weight:900}.area-top strong{color:#9aa8bb;font-size:.72rem;letter-spacing:.18em}.area-card h2{font-size:2rem}.area-link{display:inline-flex;gap:7px;color:var(--orange-dark);font-weight:850;margin-top:12px}.area-link b{transition:transform .2s ease}.area-card:hover .area-link b{transform:translateX(5px)}.coverage{display:flex;justify-content:space-between;align-items:center;gap:35px}.actions{display:flex;gap:12px;flex-wrap:wrap}@media(max-width:650px){.area-grid{grid-template-columns:1fr}.coverage{flex-direction:column;align-items:flex-start}}
</style>