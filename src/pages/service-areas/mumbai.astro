---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="AC Service in Mumbai | Maharashtra AC Service & Repair" description="Professional AC service, repair, installation and maintenance support across Mumbai including Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">Mumbai Service Area</span><h1>AC Service in Mumbai</h1><p>Reliable AC service, repair, installation and maintenance support for homes, offices, shops and commercial spaces across Mumbai and nearby service areas.</p><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call 73783 51743</a><a class="btn btn--secondary" href="/contact/">Request Service</a></div></div><div class="city-card"><span>MUMBAI</span><strong>COOLER<br/>SPACES</strong><small>LOCAL AC SUPPORT</small></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Mumbai Coverage</span><h2>Serving key Mumbai localities.</h2><p class="section-lead">For your enquiry, mention the locality and AC requirement so the service request starts with useful information.</p></div></div><div class="locality-grid">{["Andheri","Bandra","Powai","Borivali","Kandivali","Malad","Goregaon","Vile Parle","Kurla","Ghatkopar","Chembur","Thane"].map((area,i)=><article class="locality-card card"><span>{String(i+1).padStart(2,"0")}</span><h3>{area}</h3><p>AC service and repair information for customers in {area}.</p><a href="/contact/">Enquire <b>→</b></a></article>)}</div></div></section>
<section class="section section--soft"><div class="container mumbai-content"><div><span class="eyebrow">Mumbai AC Services</span><h2>Support for common AC requirements.</h2><p>From routine cleaning and maintenance to cooling problems, water leakage, unusual noise and installation requirements, use the service list to identify what you need.</p></div><div class="service-strip"><span>AC Service</span><span>AC Repair</span><span>Installation</span><span>Maintenance</span><span>Gas Service</span><span>Uninstallation</span></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Common Mumbai AC Problems</span><h2>Do not wait for a small issue to become a bigger interruption.</h2></div><div><p>Weak cooling, poor airflow, unusual sounds, water leakage or frequent switching off can indicate that an AC needs attention. Regular maintenance can also help keep filters, airflow paths and drainage in better condition.</p><p>When contacting us, share your area, AC type and the main issue. This gives the enquiry a useful starting point.</p></div></div></section>
<section class="section section--soft"><div class="container faq"><div><span class="eyebrow">Mumbai FAQs</span><h2>Quick answers.</h2></div><div><details><summary>Which Mumbai areas are covered?</summary><p>Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane are listed on this service-area page.</p></details><details><summary>What AC services are available?</summary><p>Service, repair, installation, maintenance, gas-related service and uninstallation support are available as listed on the services page.</p></details><details><summary>How can I enquire?</summary><p>Call 7378351743, email maharastraavservicerepair15@gmail.com or use the WhatsApp button on the website.</p></details></div></div></section>
</main><CTA title="Need AC Service in Mumbai?" text="Tell us your Mumbai locality and AC requirement to start your service enquiry." /><Footer /></MainLayout>
<style>
.page-hero{padding:98px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.hero-grid p{max-width:720px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.city-card{min-height:330px;border-radius:28px;background:linear-gradient(145deg,#edf7fd,#fff);border:1px solid #c7dce9;color:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;box-shadow:var(--shadow-hover)}.city-card:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(35,133,200,.15);border-radius:50%;box-shadow:0 0 0 45px rgba(35,133,200,.025),0 0 0 90px rgba(244,122,0,.018)}.city-card span,.city-card strong,.city-card small{position:relative;z-index:1}.city-card span{color:var(--orange);font-weight:900;letter-spacing:.2em}.city-card strong{font-size:2.4rem;line-height:1.02;margin:12px 0}.city-card small{color:#7c90a2;letter-spacing:.14em;font-size:.68rem}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.section-lead{max-width:680px}.locality-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}.locality-card{padding:22px}.locality-card>span{color:var(--orange);font-size:.72rem;font-weight:900}.locality-card h3{margin-top:12px}.locality-card p{font-size:.84rem;min-height:50px}.locality-card a{color:var(--orange-dark);font-weight:850;font-size:.86rem}.locality-card b{display:inline-block;transition:transform .2s ease}.locality-card:hover b{transform:translateX(4px)}.mumbai-content{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center}.service-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.service-strip span{padding:18px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:800;color:var(--navy);box-shadow:var(--shadow)}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.faq{display:grid;grid-template-columns:.7fr 1.3fr;gap:60px}.faq details{background:#fff;border:1px solid var(--border);border-radius:13px;padding:17px 20px;margin-bottom:10px}.faq summary{cursor:pointer;font-weight:800;color:var(--navy)}.faq p{margin:12px 0 0;font-size:.9rem}@media(max-width:900px){.locality-grid{grid-template-columns:1fr 1fr}.hero-grid,.mumbai-content,.split,.faq{grid-template-columns:1fr;gap:35px}}@media(max-width:560px){.locality-grid,.service-strip{grid-template-columns:1fr}}
</style>