---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="AC Service in Pune | Maharashtra AC Service & Repair" description="Professional AC service, repair, installation and maintenance support across Pune including Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">Pune Service Area</span><h1>AC Service in Pune</h1><p>Reliable AC service, repair, installation and maintenance support for homes, offices, shops and commercial spaces across Pune.</p><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call 73783 51743</a><a class="btn btn--secondary" href="/contact/">Request Service</a></div></div><div class="city-card"><span>PUNE</span><strong>COOLER<br/>SPACES</strong><small>LOCAL AC SUPPORT</small></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Pune Coverage</span><h2>AC service across key Pune areas.</h2><p class="section-lead">Our Pune service information covers the following key localities. Select an area to continue with a service enquiry.</p></div></div><div class="locality-grid">{["Baner","Balewadi","Hinjawadi","Wakad","Aundh","Pimple Saudagar","Pimple Nilakh","Pimple Gurav","Ravet","Tathawade"].map((area,i)=><a href="/contact/" class="locality-card card"><span>{String(i+1).padStart(2,"0")}</span><h3>{area}</h3><p>AC service, repair and maintenance support information for customers in {area}.</p><b>Enquire →</b></a>)}</div></div></section>
<section class="section section--soft"><div class="container pune-content"><div><span class="eyebrow">Pune Services</span><h2>Support for homes, offices and commercial spaces.</h2><p>From routine AC cleaning and maintenance to repair, installation, gas-related service and relocation, customers can choose the relevant service and share their Pune locality when contacting the team.</p></div><div class="service-strip"><span>AC Service</span><span>AC Repair</span><span>Installation</span><span>Maintenance</span><span>Gas Service</span><span>Uninstallation</span></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Local AC Problems</span><h2>Get help when cooling or operation changes.</h2></div><div><p>Weak cooling, poor airflow, water leakage, unusual sounds and repeated shutdowns are common reasons to arrange an inspection. Tell us the locality, AC type and main symptom when you enquire.</p><p>For planned maintenance, installation or relocation, share the requirement early so the enquiry includes the right context.</p></div></div></section>
<section class="section section--soft"><div class="container pune-faq"><div><span class="eyebrow">Pune FAQs</span><h2>Quick answers for local customers.</h2></div><div><details><summary>Which Pune areas are covered?</summary><p>Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade are listed on this page.</p></details><details><summary>What should I share when enquiring?</summary><p>Share your locality, AC type, number of units and the main service or problem. Model information and last service date can also be useful if available.</p></details><details><summary>Can I request repair or installation?</summary><p>Yes. The services page lists repair, installation, maintenance, gas-related support, uninstallation, relocation and other AC requirements.</p></details></div></div></section>
</main><CTA title="Need AC Service in Pune?" text="Tell us your Pune area and AC requirement to start your service enquiry." /><Footer /></MainLayout>
<style>
.page-hero{padding:78px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.hero-grid p{max-width:700px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.city-card{min-height:330px;border-radius:28px;background:linear-gradient(145deg,#edf7fd,#fff);border:1px solid #c7dce9;color:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;box-shadow:var(--shadow-hover)}.city-card:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(35,133,200,.15);border-radius:50%;box-shadow:0 0 0 45px rgba(35,133,200,.025)}.city-card span,.city-card strong,.city-card small{position:relative;z-index:1}.city-card span{color:var(--orange);font-weight:900;letter-spacing:.2em}.city-card strong{font-size:2.4rem;line-height:1.02;margin:12px 0}.city-card small{color:#7c90a2;letter-spacing:.14em;font-size:.68rem}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.section-lead{max-width:680px}.locality-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:30px}.locality-card{padding:22px}.locality-card>span{color:var(--orange);font-size:.72rem;font-weight:900}.locality-card h3{margin-top:12px}.locality-card p{font-size:.84rem;min-height:50px}.locality-card b{color:var(--orange-dark);font-size:.84rem}.service-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px}.service-strip span{padding:18px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:800;color:var(--navy);box-shadow:var(--shadow)}.pune-content{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.split,.pune-faq{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.pune-faq details{background:#fff;border:1px solid var(--border);border-radius:13px;padding:17px 20px;margin-bottom:10px}.pune-faq summary{cursor:pointer;font-weight:800;color:var(--navy)}.pune-faq p{margin:12px 0 0;font-size:.9rem}@media(max-width:1000px){.locality-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero-grid,.pune-content,.split,.pune-faq{grid-template-columns:1fr;gap:35px}.section-head{align-items:flex-start;flex-direction:column}}@media(max-width:650px){.locality-grid{grid-template-columns:1fr 1fr}.service-strip{grid-template-columns:1fr}}@media(max-width:420px){.locality-grid{grid-template-columns:1fr}}
</style>