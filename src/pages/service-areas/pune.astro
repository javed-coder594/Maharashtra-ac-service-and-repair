---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="AC Service in Pune | Maharashtra AC Service & Repair" description="Professional AC service, repair, installation and maintenance support across Pune.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">Pune Service Area</span><h1>AC Service in Pune</h1><p>Reliable AC service, repair, installation and maintenance support for homes, offices and commercial spaces across Pune.</p><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call for Pune AC Service</a><a class="btn btn--secondary" href="/contact/">Request Service</a></div></div><div class="city-card"><span>PUNE</span><strong>COOLER<br/>SPACES</strong><small>LOCAL AC SUPPORT</small></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Pune Services</span><h2>AC care for homes &amp; businesses.</h2></div><a class="text-link" href="/services/">View all services →</a></div><div class="service-strip"><span>AC Service</span><span>AC Repair</span><span>Installation</span><span>Maintenance</span><span>Gas Service</span><span>Uninstallation</span></div></div></section>
<section class="section section--soft"><div class="container split"><div><span class="eyebrow">Why Choose the Local Page?</span><h2>Find the right AC support for your Pune requirement.</h2></div><div><p>Use the service list to understand your requirement, then contact the team by phone or email. We keep the path from enquiry to service straightforward.</p><a class="btn btn--primary" href="mailto:maharastraavservicerepair15@gmail.com">Email Pune Enquiry</a></div></div></section>
</main><CTA title="Need AC Service in Pune?" text="Call or email us with your AC requirement and get started." /><Footer /></MainLayout>
<style>
.page-hero{padding:98px 0;background:radial-gradient(circle at 78% 22%,#eaf5ff,transparent 30%),linear-gradient(135deg,#f7f9fc,#fff)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.hero-grid p{max-width:690px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.city-card{min-height:330px;border-radius:28px;background:var(--navy);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;box-shadow:var(--shadow-hover)}.city-card:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(255,255,255,.14);border-radius:50%;box-shadow:0 0 0 45px rgba(255,255,255,.025)}.city-card span,.city-card strong,.city-card small{position:relative;z-index:1}.city-card span{color:var(--orange);font-weight:900;letter-spacing:.2em}.city-card strong{font-size:2.4rem;line-height:1.02;margin:12px 0}.city-card small{color:#c5d2e4;letter-spacing:.14em;font-size:.68rem}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.service-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px}.service-strip span{padding:18px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:800;color:var(--navy);box-shadow:var(--shadow)}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}@media(max-width:800px){.hero-grid,.split{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.service-strip{grid-template-columns:1fr}}
</style>