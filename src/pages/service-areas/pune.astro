---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
---
<MainLayout title="AC Service in Pune | Maharashtra AC Service & Repair" description="Professional AC service, repair, installation and maintenance support across Pune including Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">Pune Service Area</span><h1>AC Service in Pune</h1><p>Reliable AC service, repair, installation and maintenance support for homes, offices, shops and commercial spaces across Pune.</p><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call 73783 51743</a><a class="btn btn--secondary" href="/contact/">Request Service</a></div></div><div class="city-card"><span>PUNE</span><strong>COOLER<br/>SPACES</strong><small>LOCAL AC SUPPORT</small></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Pune Coverage</span><h2>Serving key Pune localities.</h2><p class="section-lead">Select your locality to quickly identify the service coverage and start an enquiry.</p></div></div><div class="locality-grid">{["Baner","Balewadi","Hinjawadi","Wakad","Aundh","Pimple Saudagar","Pimple Nilakh","Pimple Gurav","Ravet","Tathawade"].map((area,i)=><article class="locality-card card"><span>{String(i+1).padStart(2,"0")}</span><h3>{area}</h3><p>AC service and repair information for customers in {area}.</p><a href="/contact/">Enquire <b>→</b></a></article>)}</div></div></section>
<section class="section section--soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Pune Services</span><h2>AC care for homes &amp; businesses.</h2><p>Choose from routine service, repair, installation, maintenance and other AC support options.</p></div><a class="text-link" href="/services/">View all services →</a></div><div class="service-strip"><span>AC Service</span><span>AC Repair</span><span>Installation</span><span>Maintenance</span><span>Gas Service</span><span>Uninstallation</span></div></div></section>
<section class="section"><div class="container pune-content"><div><span class="eyebrow">Why Regular Service Matters</span><h2>Keep your AC ready for everyday cooling.</h2><p>Filters, airflow, drainage and general system condition can affect cooling performance. Planned maintenance can help identify issues earlier and keep routine operation more predictable.</p></div><div class="pune-points"><span>✓ Routine AC cleaning</span><span>✓ Cooling performance checks</span><span>✓ Leakage and drainage concerns</span><span>✓ Installation and relocation support</span></div></div></section>
<section class="section section--soft"><div class="container split"><div><span class="eyebrow">Pune AC Problems</span><h2>Get help when performance changes.</h2></div><div><p>If your AC is not cooling properly, is making unusual sounds, has water leakage or is switching off repeatedly, consider arranging an inspection instead of continuing to operate it without understanding the cause.</p><p>For a faster enquiry, share your Pune locality, AC type and the main issue when you contact us.</p></div></div></section>
</main><CTA title="Need AC Service in Pune?" text="Tell us your Pune area and AC requirement to start your service enquiry." /><Footer /></MainLayout>
<style>
.page-hero{padding:98px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}.hero-grid p{max-width:700px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.city-card{min-height:330px;border-radius:28px;background:linear-gradient(145deg,#edf7fd,#fff);border:1px solid #c7dce9;color:var(--navy);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;box-shadow:var(--shadow-hover)}.city-card:before{content:"";position:absolute;width:280px;height:280px;border:1px solid rgba(35,133,200,.15);border-radius:50%;box-shadow:0 0 0 45px rgba(35,133,200,.025)}.city-card span,.city-card strong,.city-card small{position:relative;z-index:1}.city-card span{color:var(--orange);font-weight:900;letter-spacing:.2em}.city-card strong{font-size:2.4rem;line-height:1.02;margin:12px 0}.city-card small{color:#7c90a2;letter-spacing:.14em;font-size:.68rem}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.section-lead{max-width:680px}.locality-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:30px}.locality-card{padding:22px}.locality-card>span{color:var(--orange);font-size:.72rem;font-weight:900}.locality-card h3{margin-top:12px}.locality-card p{font-size:.84rem;min-height:50px}.locality-card a{color:var(--orange-dark);font-weight:850;font-size:.86rem}.locality-card b{display:inline-block;transition:transform .2s ease}.locality-card:hover b{transform:translateX(4px)}.service-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px}.service-strip span{padding:18px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:800;color:var(--navy);box-shadow:var(--shadow)}.pune-content{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.pune-points{display:grid;grid-template-columns:1fr 1fr;gap:12px}.pune-points span{padding:16px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:750;color:var(--navy)}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}@media(max-width:1000px){.locality-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.hero-grid,.pune-content,.split{grid-template-columns:1fr;gap:35px}.section-head{align-items:flex-start;flex-direction:column}}@media(max-width:650px){.locality-grid{grid-template-columns:1fr 1fr}.service-strip,.pune-points{grid-template-columns:1fr}}@media(max-width:420px){.locality-grid{grid-template-columns:1fr}}
</style>