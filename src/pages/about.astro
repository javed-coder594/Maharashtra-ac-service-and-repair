---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="About Us | Maharashtra AC Service & Repair" description="Learn about Maharashtra AC Service & Repair and our customer-first approach to AC service across Pune and Mumbai.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">About Us</span><h1>Dependable AC care, explained simply.</h1><p>We focus on making AC service, repair, installation and maintenance easier to understand for homes, offices, shops and commercial spaces across Pune and Mumbai.</p><div class="hero-actions"><a class="btn btn--primary" href="/contact/">Talk to Our Team</a><a class="btn btn--secondary" href="/services/">Explore Services</a></div></div><div class="about-visual"><div class="ring"></div><div class="visual-core"><span>AC</span><strong>CARE</strong><small>PUNE • MUMBAI</small></div></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Our Approach</span><h2>Practical service information before the service call.</h2></div><div><p>Air conditioning problems can range from simple maintenance needs to issues that require detailed inspection. We present services in clear categories so customers can describe what they need more confidently.</p><p>Whether you are booking routine cleaning, looking for repair support, planning an installation or preparing an AC for relocation, the goal is a smooth and direct enquiry.</p><p>We also organize city-level information so customers can quickly find the Pune or Mumbai page and see the relevant localities before getting in touch.</p></div></div></section>
<section class="section section--soft"><div class="container values"><article class="value"><span>01</span><h3>Customer First</h3><p>Useful information, simple navigation and direct contact options help reduce confusion.</p></article><article class="value"><span>02</span><h3>Local Coverage</h3><p>Dedicated Pune and Mumbai pages make it easier to find relevant service-area information.</p></article><article class="value"><span>03</span><h3>Complete AC Care</h3><p>Service, repair, installation, gas-related support and maintenance are organized in one place.</p></article><article class="value"><span>04</span><h3>Clear Enquiries</h3><p>We encourage customers to share their area, AC type and main concern when contacting the team.</p></article></div></section>
<section class="section"><div class="container about-sections"><div><span class="eyebrow">What We Help With</span><h2>From routine care to unexpected AC issues.</h2><p>Regular AC service can help maintain airflow and cooling performance. When an issue appears, timely inspection can help identify the cause and prevent avoidable disruption.</p></div><div class="about-points"><div><b>AC Service</b><span>Cleaning and performance checks.</span></div><div><b>AC Repair</b><span>Support for common cooling and operational problems.</span></div><div><b>Installation</b><span>Installation support for new systems.</span></div><div><b>Maintenance</b><span>Planned care for homes and workplaces.</span></div><div><b>Gas Support</b><span>Refrigerant-related inspection and leakage repair.</span></div><div><b>Relocation</b><span>Uninstallation and installation coordination when moving an AC.</span></div></div></div></section>
<section class="section section--soft"><div class="container process-section"><div><span class="eyebrow">How We Work</span><h2>A simple service journey.</h2><p>Good communication starts before the service visit. Sharing useful details helps the enquiry begin with the right context.</p></div><div class="process-steps"><div><b>01</b><h3>Share the requirement</h3><p>Tell us the locality, AC type and main issue.</p></div><div><b>02</b><h3>Discuss the support</h3><p>Use the available contact channel to clarify the service needed.</p></div><div><b>03</b><h3>Proceed with service</h3><p>Move forward with the appropriate AC support for the requirement.</p></div></div></div></section>
<section class="section"><div class="container story"><div><span class="eyebrow">Pune & Mumbai</span><h2>Built around local service requirements.</h2></div><div><p>Pune coverage includes Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade. Mumbai coverage includes Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane.</p><a class="text-link" href="/service-areas/">Explore service areas →</a></div></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.page-hero{padding:82px 0}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center}.hero-grid p{max-width:690px;font-size:1.08rem}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.about-visual{min-height:360px;display:grid;place-items:center;position:relative}.ring{width:300px;height:300px;border-radius:50%;border:2px solid rgba(244,122,0,.55);box-shadow:0 0 0 35px rgba(244,122,0,.05),0 0 0 80px rgba(35,133,200,.04);animation:pulse 4s ease-in-out infinite}.visual-core{position:absolute;width:190px;height:190px;border-radius:50%;background:linear-gradient(145deg,#eaf5ff,#fff);border:1px solid #bfd5e5;color:var(--navy);display:grid;place-items:center;align-content:center;box-shadow:var(--shadow-hover);text-align:center}.visual-core span{font-size:2.8rem;font-weight:900;line-height:1}.visual-core strong{color:var(--orange);letter-spacing:.12em}.visual-core small{margin-top:12px;color:#7b8ea0;font-size:.62rem;letter-spacing:.14em}.split,.about-sections,.story,.process-section{display:grid;grid-template-columns:1fr 1fr;gap:70px}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.value{background:#fff;border:1px solid var(--border);border-radius:18px;padding:26px;box-shadow:var(--shadow);transition:transform .25s ease,box-shadow .25s ease}.value:hover{transform:translateY(-5px);box-shadow:var(--shadow-hover)}.value>span{color:var(--orange);font-weight:900;font-size:.8rem}.value h3{margin-top:16px}.value p{margin-bottom:0}.about-points{display:grid;grid-template-columns:1fr 1fr;gap:12px}.about-points>div{padding:20px;border:1px solid var(--border);border-radius:14px;background:#fff}.about-points b{display:block;color:var(--navy);margin-bottom:4px}.about-points span{font-size:.88rem;color:var(--muted)}.process-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.process-steps>div{padding:22px;background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow)}.process-steps b{color:var(--orange);font-size:.75rem}.process-steps h3{margin-top:13px;font-size:1.05rem}.process-steps p{font-size:.86rem;margin-bottom:0}@keyframes pulse{50%{transform:scale(1.03)}}@media(max-width:900px){.hero-grid,.split,.about-sections,.story,.process-section{grid-template-columns:1fr;gap:35px}.values{grid-template-columns:1fr 1fr}.process-steps{grid-template-columns:1fr 1fr}}@media(max-width:560px){.values,.about-points,.process-steps{grid-template-columns:1fr}.page-hero{padding:54px 0 60px}.page-hero .hero-grid{grid-template-columns:1fr;gap:28px;width:100%;min-width:0}.page-hero h1{font-size:clamp(2.55rem,9.5vw,3.8rem);line-height:1.04;max-width:100%;overflow-wrap:normal}.page-hero p{font-size:1rem;line-height:1.65;max-width:100%}.hero-actions{gap:10px;margin-top:20px}.hero-actions .btn{flex:1 1 165px;min-width:0;padding-inline:16px}.about-visual{min-height:255px;width:100%;overflow:hidden}.ring{width:235px;height:235px;box-shadow:0 0 0 25px rgba(244,122,0,.05),0 0 0 55px rgba(35,133,200,.04)}.visual-core{width:155px;height:155px}.visual-core span{font-size:2.3rem}.visual-core small{font-size:.56rem;margin-top:9px}}
</style>