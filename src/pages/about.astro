---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="About Us | Maharashtra AC Service & Repair" description="Learn about Maharashtra AC Service & Repair and our customer-first approach to AC service across Pune and Mumbai.">
<Header /><main>
<section class="page-hero"><div class="container hero-grid"><div><span class="eyebrow">About Us</span><h1>Comfort starts with dependable AC care.</h1><p>We are focused on making AC service, repair, installation and maintenance simpler for homes, offices and commercial spaces across Pune and Mumbai.</p><a class="btn btn--primary" href="/contact/">Talk to Our Team</a></div><div class="about-visual"><div class="ring"></div><div class="visual-core"><span>AC</span><strong>CARE</strong><small>PUNE • MUMBAI</small></div></div></div></section>
<section class="section"><div class="container split"><div><span class="eyebrow">Our Approach</span><h2>Clear service. Practical solutions. Better comfort.</h2></div><div><p>Every AC issue is different. Our website is built to help customers quickly understand available services, choose their city and contact the team without unnecessary steps.</p><p>From routine cleaning to repair and installation support, the goal is straightforward: clear communication and a smooth service experience.</p></div></div></section>
<section class="section section--soft"><div class="container values"><article class="value"><span>01</span><h3>Customer First</h3><p>Keep service information simple, useful and easy to act on.</p></article><article class="value"><span>02</span><h3>Local Coverage</h3><p>Dedicated service-area information for Pune and Mumbai customers.</p></article><article class="value"><span>03</span><h3>Complete AC Care</h3><p>Service, repair, installation and maintenance in one place.</p></article></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.page-hero{padding:98px 0;background:radial-gradient(circle at 82% 30%,#eaf5ff,transparent 30%),linear-gradient(135deg,#f7f9fc,#fff)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:center}.hero-grid p{max-width:690px;font-size:1.08rem}.about-visual{min-height:360px;display:grid;place-items:center;position:relative}.ring{width:300px;height:300px;border-radius:50%;border:2px solid rgba(244,122,0,.55);box-shadow:0 0 0 35px rgba(244,122,0,.05),0 0 0 80px rgba(22,119,200,.04);animation:pulse 4s ease-in-out infinite}.visual-core{position:absolute;width:190px;height:190px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;align-content:center;box-shadow:var(--shadow-hover);text-align:center}.visual-core span{font-size:2.8rem;font-weight:900;line-height:1}.visual-core strong{color:var(--orange);letter-spacing:.12em}.visual-core small{margin-top:12px;color:#c6d3e4;font-size:.62rem;letter-spacing:.14em}.split{display:grid;grid-template-columns:1fr 1fr;gap:70px}.values{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.value{background:#fff;border:1px solid var(--border);border-radius:18px;padding:28px;box-shadow:var(--shadow)}.value>span{color:var(--orange);font-weight:900;font-size:.8rem}.value h3{margin-top:18px}.value p{margin-bottom:0}@keyframes pulse{50%{transform:scale(1.03)}}@media(max-width:800px){.hero-grid,.split{grid-template-columns:1fr;gap:35px}.about-visual{min-height:300px}.values{grid-template-columns:1fr}}
</style>