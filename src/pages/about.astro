---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="About Us | Maharashtra AC Service & Repair"><Header /><main><section class="page-hero"><div class="container"><span class="eyebrow">About Us</span><h1>Comfort starts with dependable AC service.</h1><p>We provide professional AC service and repair support for residential and commercial customers across Pune and Mumbai.</p></div></section><section class="section"><div class="container two"><div><span class="eyebrow">Our Approach</span><h2>Service built around your comfort.</h2></div><div><p>Our website and service system are designed around clear communication, practical solutions and dependable customer support.</p><p>Business details, technician information and service policies can be added here as the final content is provided.</p></div></div></section></main><CTA /><Footer /></MainLayout>
<style>.page-hero{padding:100px 0;background:linear-gradient(135deg,#f7f9fc,#eaf5ff)}.page-hero p{max-width:720px;font-size:1.1rem}.two{display:grid;grid-template-columns:1fr 1fr;gap:70px}@media(max-width:700px){.two{grid-template-columns:1fr;gap:20px}}</style>