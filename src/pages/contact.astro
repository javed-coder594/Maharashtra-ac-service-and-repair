---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="Contact | Maharashtra AC Service & Repair" description="Contact Maharashtra AC Service & Repair for AC service, repair, installation and maintenance in Pune and Mumbai.">
<Header /><main>
<section class="page-hero"><div class="container hero-inner"><span class="eyebrow">Get In Touch</span><h1>Let’s get your AC back to its best.</h1><p>Tell us your location and what your AC needs. Use the phone, email or WhatsApp options below to start a service enquiry.</p><div class="hero-actions"><a class="btn btn--primary" href="tel:+917378351743">Call +91 73783 51743</a><a class="btn btn--secondary" href="mailto:maharastraavservicerepair15@gmail.com">Email Us</a></div></div></section>
<section class="section"><div class="container contact-grid">
<div class="contact-info"><span class="eyebrow">Contact Details</span><h2>Simple, direct support.</h2><p>For service enquiries across Pune and Mumbai, reach us by phone, email or WhatsApp. Mention your area, AC type and the issue you are experiencing when possible.</p>
<div class="info-list"><a class="info-card" href="tel:+917378351743"><span class="info-icon">☎</span><span><small>Phone</small><strong>+91 73783 51743</strong></span></a><a class="info-card" href="mailto:maharastraavservicerepair15@gmail.com"><span class="info-icon">@</span><span><small>Email</small><strong>maharastraavservicerepair15@gmail.com</strong></span></a><a class="info-card" href="https://wa.me/917378351743?text=Hello%20Maharashtra%20AC%20Service%20%26%20Repair%2C%20I%20need%20AC%20service." target="_blank" rel="noopener"><span class="info-icon">◉</span><span><small>WhatsApp</small><strong>Chat with 73783 51743</strong></span></a><div class="info-card"><span class="info-icon">⌖</span><span><small>Service Areas</small><strong>Pune &amp; Mumbai</strong></span></div></div></div>
<div><form class="card form" action="#" method="post" onsubmit="return false"><div class="form-head"><span>Service Enquiry</span><h2>Tell us what you need.</h2><p>Use this form as a quick enquiry guide, then contact the team using the phone or WhatsApp button.</p></div><label>Name<input name="name" autocomplete="name" placeholder="Your name" required /></label><label>Phone<input name="phone" type="tel" autocomplete="tel" placeholder="Your phone number" required /></label><label>Location<input name="location" placeholder="Pune / Mumbai + area" /></label><label>Service Needed<select name="service"><option>AC Service</option><option>AC Repair</option><option>AC Installation</option><option>AC Maintenance</option><option>AC Gas Service</option><option>AC Uninstallation</option></select></label><label>Message<textarea name="message" rows="4" placeholder="Describe the AC issue or requirement..."></textarea></label><button class="btn btn--primary" type="submit">Prepare Enquiry <span>↗</span></button><p class="form-note">Prefer direct contact? Call <a href="tel:+917378351743">7378351743</a> or email <a href="mailto:maharastraavservicerepair15@gmail.com">maharastraavservicerepair15@gmail.com</a>.</p></form></div>
</div></section>
<section class="section section--soft"><div class="container enquiry-tips"><div><span class="eyebrow">Before You Contact Us</span><h2>Useful details to share.</h2></div><div class="tips"><span>✓ Your area or locality</span><span>✓ Split, window or cassette AC</span><span>✓ Cooling, leakage or noise issue</span><span>✓ Installation or maintenance requirement</span></div></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.page-hero{padding:104px 0 92px}.hero-inner{max-width:900px}.page-hero p{max-width:760px;font-size:1.08rem}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:start}.contact-info>p{max-width:560px}.info-list{display:grid;gap:12px;margin-top:30px}.info-card{display:flex;align-items:center;gap:15px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:15px;transition:transform .25s ease,box-shadow .25s ease}.info-card:hover{transform:translateX(4px);box-shadow:var(--shadow)}.info-icon{width:42px;height:42px;display:grid;place-items:center;background:#fff;color:var(--orange);border-radius:12px;font-weight:900}.info-card small{display:block;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.info-card strong{display:block;color:var(--navy);font-size:.92rem;overflow-wrap:anywhere}.form{padding:32px}.form-head>span{color:var(--orange);font-size:.75rem;font-weight:850;text-transform:uppercase;letter-spacing:.1em}.form-head h2{margin-top:7px}.form{display:grid;gap:17px}.form label{display:grid;gap:7px;font-weight:750;color:var(--navy)}.form input,.form textarea,.form select{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:11px;background:#fff;font:inherit;outline:none;transition:border-color .2s ease,box-shadow .2s ease}.form input:focus,.form textarea:focus,.form select:focus{border-color:#9eb6d0;box-shadow:0 0 0 4px rgba(35,133,200,.08)}.form button{border:0;cursor:pointer}.form-note{font-size:.78rem;margin:0}.form-note a{color:var(--orange-dark);font-weight:800}.enquiry-tips{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.tips{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tips span{padding:16px;background:#fff;border:1px solid var(--border);border-radius:13px;font-weight:750;color:var(--navy)}@media(max-width:800px){.contact-grid,.enquiry-tips{grid-template-columns:1fr;gap:45px}}@media(max-width:560px){.tips{grid-template-columns:1fr}}
</style>