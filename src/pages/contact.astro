---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<MainLayout title="Contact | Maharashtra AC Service & Repair"><Header /><main><section class="page-hero"><div class="container"><span class="eyebrow">Contact</span><h1>Book AC service with our team.</h1><p>Contact details, service hours and enquiry form will be finalized when the business information is provided.</p></div></section><section class="section"><div class="container contact-grid"><div class="card info"><h2>Get in touch</h2><p><strong>Phone:</strong> <a href="tel:+919021803472">+91 90218 03472</a></p><p><strong>Service:</strong> Pune & Mumbai</p><p><strong>Hours:</strong> To be confirmed</p></div><form class="card form"><label>Name<input name="name" required /></label><label>Phone<input name="phone" type="tel" required /></label><label>Message<textarea name="message" rows="5"></textarea></label><button class="btn btn--primary" type="submit">Request Service</button></form></div></section></main><Footer /></MainLayout>
<style>.page-hero{padding:100px 0;background:linear-gradient(135deg,#f7f9fc,#eaf5ff)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}.info,.form{padding:32px}.form{display:grid;gap:18px}.form label{display:grid;gap:7px;font-weight:700}.form input,.form textarea{width:100%;padding:13px 14px;border:1px solid var(--border);border-radius:10px;font:inherit}.form button{border:0;cursor:pointer}@media(max-width:700px){.contact-grid{grid-template-columns:1fr}}</style>