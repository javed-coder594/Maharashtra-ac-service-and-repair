---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="Maharashtra AC Service & Repair | Pune & Mumbai" description="Professional AC service, repair, installation and maintenance for homes, offices and commercial spaces across Pune and Mumbai.">
<Header /><main>
<section class="hero"><div class="container hero-grid">
<div class="hero-copy reveal"><span class="eyebrow">Pune & Mumbai AC Experts</span><h1>Reliable AC Service.<br /><span>Comfort You Can Count On.</span></h1><p class="lead">Professional air conditioner service, repair, installation and maintenance for homes, offices, shops and commercial spaces. Get practical support for routine maintenance or an unexpected AC problem.</p><div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call 73783 51743 <span>↗</span></a><a class="btn btn--secondary" href="/services/">Explore Services</a></div><div class="trust"><span>✓ Local service coverage</span><span>✓ Clear communication</span><span>✓ Home & business support</span></div></div>
<div class="hero-art reveal delay-2" aria-hidden="true"><div class="orb orb--orange"></div><div class="orb orb--blue"></div><div class="ac-unit"><span></span><i></i><i></i><i></i><i></i></div><div class="cool-air">✦</div><div class="float-badge">Fast <strong>AC Support</strong></div></div>
</div></section>

<section class="section"><div class="container intro-grid"><div><span class="eyebrow">Complete AC Care</span><h2>One place for service, repair, installation and maintenance.</h2></div><div><p>Air conditioners need more than occasional cleaning. Good maintenance helps identify airflow, drainage, cooling and performance problems before they become bigger interruptions.</p><p>Our service information is designed for customers in Pune and Mumbai who want a straightforward way to understand the requirement and contact the team.</p></div></div></section>

<section class="section section--soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Our Services</span><h2>AC support for everyday requirements.</h2></div><a class="text-link" href="/services/">View all services →</a></div><div class="grid service-grid">{[["❄","AC Service","Cleaning, inspection and performance checks."],["⚙","AC Repair","Support for cooling, noise, leakage and other issues."],["＋","AC Installation","Installation support for new AC systems."],["◌","AC Gas Service","Refrigerant-related inspection and service."],["✓","AC Maintenance","Preventive care for dependable performance."],["↗","AC Uninstallation","Careful removal for relocation or replacement."]].map(([icon,title,text],i)=><article class={"card service-card reveal delay-"+((i%3)+1)}><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p><a href="/services/">Learn more <span>→</span></a></article>)}</div></div></section>

<section class="section"><div class="container feature-grid"><div class="feature-copy"><span class="eyebrow">When Your AC Needs Attention</span><h2>Small signs can point to bigger AC problems.</h2><p>If cooling feels weaker, water is dripping, the unit is making unusual sounds, airflow is poor or the AC is repeatedly switching off, it is worth checking the system rather than waiting for a complete failure.</p><div class="issue-list"><span><b>01</b> Weak or uneven cooling</span><span><b>02</b> Water leakage or drainage concerns</span><span><b>03</b> Unusual noise or smell</span><span><b>04</b> Higher-than-usual energy use</span></div></div><img class="feature-image" src="/images/ac-repair-warning.svg" alt="AC repair warning signs illustration" width="1200" height="700" loading="lazy" /></div></section>

<section class="section section--soft"><div class="container why-grid"><div><span class="eyebrow">Why Local Support Matters</span><h2>Service information built around Pune and Mumbai customers.</h2><p>Different buildings, usage patterns and operating conditions can affect AC performance. A local service page helps customers quickly identify their area and the type of support they are looking for.</p></div><div class="why-cards"><article class="card why-card"><b>01</b><h3>Clear Options</h3><p>Understand common AC services before contacting the team.</p></article><article class="card why-card"><b>02</b><h3>City Coverage</h3><p>Dedicated information for Pune and Mumbai service requirements.</p></article><article class="card why-card"><b>03</b><h3>Easy Contact</h3><p>Call, email or use WhatsApp to start your service enquiry.</p></article></div></div></section>

<section class="section home-process"><div class="container"><div class="section-head"><div><span class="eyebrow">Simple Process</span><h2>From enquiry to AC support.</h2></div></div><div class="process-grid"><article><span>01</span><h3>Tell us the requirement</h3><p>Share your city, locality, AC type and the main problem or service needed.</p></article><article><span>02</span><h3>Choose the right service</h3><p>Use the detailed service guide to understand the likely starting point for your enquiry.</p></article><article><span>03</span><h3>Connect with the team</h3><p>Call, email or WhatsApp to discuss the requirement and next steps.</p></article></div></div></section>

<section class="section location-section"><div class="container"><div class="section-head location-head"><div><span class="eyebrow">Service Areas</span><h2>AC service coverage in Pune & Mumbai.</h2><p>Choose your city to explore the local areas and detailed AC service information.</p></div></div><div class="city-area-grid">
<a class="city-area-card" href="/service-areas/mumbai/"><div class="city-area-image"><img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/Mumbai" alt="Mumbai service area" width="900" height="650" loading="lazy" /></div><div class="city-area-content"><span class="city-label">MUMBAI</span><h3>AC Service in Mumbai</h3><p>Explore AC service coverage across Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane.</p><strong>Explore Mumbai Areas <b>→</b></strong></div></a>
<a class="city-area-card" href="/service-areas/pune/"><div class="city-area-image"><img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/Pune" alt="Pune service area" width="900" height="650" loading="lazy" /></div><div class="city-area-content"><span class="city-label">PUNE</span><h3>AC Service in Pune</h3><p>Explore AC service coverage across Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade.</p><strong>Explore Pune Areas <b>→</b></strong></div></a>
</div></div></section>

<section class="section section--soft"><div class="container faq-preview"><div><span class="eyebrow">Helpful AC Guidance</span><h2>Questions customers often have.</h2></div><div class="faq-list"><details><summary>How often should an AC be serviced?</summary><p>Regular servicing depends on usage, environment and the type of AC. Homes with frequent use can benefit from planned maintenance rather than waiting for performance to drop.</p></details><details><summary>What should I do if my AC is not cooling?</summary><p>Check basic airflow and settings first. If cooling remains weak, a professional inspection can help identify issues involving filters, airflow, drainage, refrigerant or other components.</p></details><details><summary>Do you provide AC support in Pune and Mumbai?</summary><p>Yes. Dedicated Pune and Mumbai service-area pages list the key localities covered by the website.</p></details></div></div></section>
</main><CTA /><Footer /></MainLayout>
<style>
.hero{padding:76px 0 68px}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:45px}.hero h1{font-size:clamp(2.8rem,4.7vw,4.45rem);max-width:720px;margin-top:16px}.hero h1 span{color:var(--orange)}.lead{max-width:690px;font-size:1.04rem}.actions{display:flex;gap:12px;flex-wrap:wrap}.trust{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px;color:#e5eef7;font-size:.82rem;font-weight:800}.hero-art{min-height:360px;position:relative;display:grid;place-items:center}.orb{position:absolute;border-radius:50%;border:14px solid}.orb--orange{width:310px;height:310px;border-color:var(--orange) transparent transparent transparent;transform:rotate(-25deg);animation:spin-slow 16s linear infinite}.orb--blue{width:285px;height:285px;border-color:var(--blue) transparent transparent transparent;transform:rotate(155deg);animation:spin-slow-reverse 18s linear infinite}.ac-unit{position:relative;z-index:2;width:min(370px,84%);height:135px;border:2px solid #c9d7e3;border-radius:18px 18px 30px 30px;background:#fff;box-shadow:0 24px 50px rgba(35,73,110,.16);transition:transform .35s ease,box-shadow .35s ease}.hero-art:hover .ac-unit{transform:translateY(-8px);box-shadow:0 32px 65px rgba(35,73,110,.2)}.ac-unit span{position:absolute;left:12%;right:12%;top:45%;height:6px;background:#dce6ee;border-radius:10px}.ac-unit i{position:relative;display:inline-block;width:14%;height:7px;margin:83px 1.3%;background:var(--blue);border-radius:0 0 12px 12px}.cool-air{position:absolute;z-index:1;bottom:24px;font-size:3.5rem;color:var(--blue);opacity:.75;animation:float 3.5s ease-in-out infinite}.float-badge{position:absolute;right:0;bottom:42px;z-index:3;background:#fff;border:1px solid var(--border);box-shadow:var(--shadow);border-radius:16px;padding:11px 15px;font-size:.73rem;color:var(--muted)}.float-badge strong{display:block;color:var(--navy);font-size:.86rem}.intro-grid,.feature-grid,.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.intro-grid p:last-child{margin-bottom:0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px}.service-grid{grid-template-columns:repeat(3,1fr);margin-top:34px}.service-card{padding:26px;box-shadow:none}.icon{width:46px;height:46px;display:grid;place-items:center;border-radius:13px;background:var(--blue-light);color:var(--blue);margin-bottom:20px;font-size:1.2rem}.service-card a{color:var(--orange-dark);font-weight:800}.service-card a span{display:inline-block;transition:transform .25s ease}.service-card:hover a span{transform:translateX(5px)}.feature-image{width:100%;max-width:540px;margin-inline:auto}.issue-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:25px}.issue-list span{padding:13px 14px;border:1px solid var(--border);border-radius:12px;background:#fff;font-size:.9rem}.issue-list b{color:var(--orange);margin-right:7px}.why-cards{display:grid;grid-template-columns:1fr;gap:12px}.why-card{padding:22px}.why-card>b{color:var(--orange);font-size:.75rem}.why-card h3{margin-top:10px}.why-card p{margin-bottom:0}.home-process{background:#f7fafc}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.process-grid article{padding:28px;background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.process-grid span{color:var(--orange);font-weight:900;font-size:.78rem}.process-grid h3{margin-top:13px}.process-grid p{margin-bottom:0}.location-section{background:#eef4f8}.location-head{margin-bottom:30px}.city-area-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.city-area-card{display:block;overflow:hidden;border:1px solid #cad9e5;border-radius:24px;background:#fff;box-shadow:0 16px 40px rgba(25,59,99,.09);transition:transform .3s ease,box-shadow .3s ease}.city-area-card:hover{transform:translateY(-7px);box-shadow:0 24px 55px rgba(25,59,99,.15)}.city-area-image{height:300px;overflow:hidden;background:#e8f0f5}.city-area-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}.city-area-card:hover .city-area-image img{transform:scale(1.045)}.city-area-content{padding:26px 26px 28px}.city-label{font-size:.73rem;font-weight:900;letter-spacing:.18em;color:var(--orange)}.city-area-content h3{font-size:1.55rem;margin:10px 0 8px;color:var(--navy)}.city-area-content p{font-size:.9rem;margin-bottom:18px}.city-area-content strong{color:var(--orange-dark);font-size:.9rem}.city-area-content strong b{display:inline-block;margin-left:5px;transition:transform .2s ease}.city-area-card:hover .city-area-content strong b{transform:translateX(5px)}.faq-preview{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.faq-list{display:grid;gap:10px}.faq-list details{background:#fff;border:1px solid var(--border);border-radius:13px;padding:17px 20px}.faq-list summary{cursor:pointer;font-weight:800;color:var(--navy)}.faq-list p{margin:12px 0 0;font-size:.9rem}@keyframes spin-slow{to{transform:rotate(335deg)}}@keyframes spin-slow-reverse{to{transform:rotate(-205deg)}}@keyframes float{50%{transform:translateY(-10px)}}@media(max-width:850px){.hero-grid,.intro-grid,.feature-grid,.why-grid,.faq-preview{grid-template-columns:1fr;gap:40px}.process-grid{grid-template-columns:1fr 1fr}.city-area-grid{grid-template-columns:1fr}.hero-art{min-height:320px}.city-area-image{height:270px}}@media(max-width:560px){.service-grid,.issue-list,.process-grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.hero{padding-top:60px}.city-area-image{height:220px}}
</style>