---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<MainLayout title="Maharashtra AC Service & Repair | Pune & Mumbai" description="Maharashtra AC Service & Repair provides AC servicing, repair and installation support in Pune and Mumbai. Contact us to discuss your AC needs.">
  <Header />
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <p class="eyebrow">AC Service • Repair • Installation</p>
        <h1 id="hero-title">Maharashtra <span>AC Service &amp; Repair</span></h1>
        <p class="hero-description">Reliable AC servicing, repair and installation for homes and businesses.<br class="desktop-break" /> Serving customers across Pune and Mumbai.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact/">Book AC Service <span aria-hidden="true">↗</span></a>
          <a class="btn btn-whatsapp" href="https://wa.me/917378351743" target="_blank" rel="noopener noreferrer">WhatsApp Us</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>
<style>
.hero{position:relative;isolation:isolate;display:flex;align-items:center;min-height:clamp(560px,calc(100svh - 88px),780px);overflow:hidden;background:#0b2e63 url("https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/b671017e-e09d-4ffb-ac43-7da476274593") center/cover no-repeat;color:#fff}
.hero-overlay{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(5,25,57,.88) 0%,rgba(5,25,57,.72) 48%,rgba(5,25,57,.28) 100%)}
.hero-content{position:relative;padding-top:72px;padding-bottom:72px}
.eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 22px;color:#ffad52;font-size:.82rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
.eyebrow:before{content:"";width:28px;height:3px;border-radius:9px;background:#f47a00}
.hero h1{max-width:850px;margin:0;color:#fff;font-size:clamp(2.7rem,6vw,5.4rem);font-weight:900;letter-spacing:-.045em;line-height:1.04;text-wrap:balance}
.hero h1 span{display:block;color:#ff922e}
.hero-description{max-width:660px;margin:24px 0 30px;color:#f2f6fc;font-size:clamp(1rem,1.7vw,1.2rem);line-height:1.8}
.hero-actions{display:flex;flex-wrap:wrap;gap:14px}
.btn{display:inline-flex;min-height:52px;align-items:center;justify-content:center;gap:10px;padding:14px 23px;border:1px solid transparent;border-radius:999px;font-weight:850;text-decoration:none;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:#f47a00;color:#fff;box-shadow:0 10px 28px rgba(244,122,0,.25)}
.btn-primary:hover{background:#dc6900;box-shadow:0 14px 32px rgba(244,122,0,.32)}
.btn-whatsapp{border-color:rgba(255,255,255,.75);background:rgba(255,255,255,.1);color:#fff;backdrop-filter:blur(8px)}
.btn-whatsapp:hover{background:rgba(255,255,255,.2)}
@media(max-width:600px){.hero{min-height:calc(100svh - 70px);background-position:58% center}.hero-overlay{background:linear-gradient(90deg,rgba(5,25,57,.88),rgba(5,25,57,.65))}.hero-content{padding-top:60px;padding-bottom:60px}.eyebrow{font-size:.7rem;letter-spacing:.1em;margin-bottom:18px}.hero h1{font-size:clamp(2.55rem,11vw,4rem);line-height:1.05}.hero-description{margin:20px 0 26px;font-size:1rem;line-height:1.7}.desktop-break{display:none}.hero-actions{display:grid;grid-template-columns:1fr;max-width:320px}.btn{width:100%;padding:14px 18px}}
@media(prefers-reduced-motion:reduce){.btn{transition:none}}
</style>
