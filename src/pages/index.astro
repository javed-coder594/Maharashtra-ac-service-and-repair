---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="AC Service & Repair in Pune & Mumbai | Maharashtra AC Service" description="Explore AC service, repair, installation and maintenance in Pune and Mumbai. Check service options and contact Maharashtra AC Service & Repair.">
<Header />
<main>
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-content">
    <div class="hero-copy">
      <p class="eyebrow">AC Service • Repair • Installation</p>
      <h1 id="hero-title">Stay cool.<br /><span>We take care of your AC.</span></h1>
      <p class="hero-description">Fast, reliable AC service and repair for homes and businesses across Pune and Mumbai.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="tel:+917378351743">Call Now <span aria-hidden="true">↗</span></a>
        <a class="btn btn-secondary" href="/services/">Explore Services</a>
      </div>
      <div class="hero-trust"><span>✓ Experienced technicians</span><span>✓ Service across Pune &amp; Mumbai</span></div>
    </div>
    <div class="hero-visual" aria-label="Air conditioner illustration and available service options">
      <div class="cool-glow"></div><div class="floating-spark spark-one">✦</div><div class="floating-spark spark-two">✧</div>
      <div class="temp-badge"><span class="temp-dot"></span><div><small>ROOM TEMPERATURE</small><strong>16<sup>°C</sup></strong></div><span class="snow">❄</span></div>
      <div class="ac-unit"><div class="ac-top"><span class="ac-brand">COOL<span>+</span></span><span class="ac-status"></span></div><div class="ac-vent"></div><div class="ac-display">16°</div></div>
      <div class="air-flow"><span></span><span></span><span></span><span></span></div>
      <div class="service-booking"><h2>Book an AC technician</h2><p>Pick what you need. We'll confirm the visit time and price.</p>
        <div class="service-pills"><a href="/services/">❄ AC Service <b>₹499</b></a><a href="/services/">Repair</a><a href="/services/">Installation <b>₹999</b></a><a href="/services/">Gas Filling <b>₹2,500</b></a><a href="/services/">Uninstall + Install</a><a href="/contact/">HVAC Quote</a></div>
        <a class="booking-link" href="/contact/">Book your service <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="section"><div class="container intro-grid"><div><span class="eyebrow">Complete AC Care</span><h2>One place for service, repair, installation and maintenance.</h2></div><div><p>Air conditioners need more than occasional cleaning. Good maintenance helps identify airflow, drainage, cooling and performance problems before they become bigger interruptions.</p><p>Our service information is designed for customers in Pune and Mumbai who want a straightforward way to understand the requirement and contact the team.</p></div></div></section>

<section class="section section--soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Our Services</span><h2>AC support for everyday requirements.</h2></div><a class="text-link" href="/services/">View all services →</a></div><div class="grid service-grid">{[["❄","AC Service","Cleaning, inspection and performance checks."],["⚙","AC Repair","Support for cooling, noise, leakage and other issues."],["＋","AC Installation","Installation support for new AC systems."],["◌","AC Gas Service","Refrigerant-related inspection and service."],["✓","AC Maintenance","Preventive care for dependable performance."],["↗","AC Uninstallation","Careful removal for relocation or replacement."]].map(([icon,title,text],i)=><article class={"card service-card reveal delay-"+((i%3)+1)}><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p><a href="/services/">Learn more <span>→</span></a></article>)}</div></div></section>

<section class="section"><div class="container feature-grid"><div class="feature-copy"><span class="eyebrow">When Your AC Needs Attention</span><h2>Small signs can point to bigger AC problems.</h2><p>If cooling feels weaker, water is dripping, the unit is making unusual sounds, airflow is poor or the AC is repeatedly switching off, it is worth checking the system rather than waiting for a complete failure.</p><div class="issue-list"><span><b>01</b> Weak or uneven cooling</span><span><b>02</b> Water leakage or drainage concerns</span><span><b>03</b> Unusual noise or smell</span><span><b>04</b> Higher-than-usual energy use</span></div></div><img class="feature-image" src="https://res.cloudinary.com/mnqvmnca/image/upload/v1795588073/82fc83a0-545d-44af-b29c-79e6cd1e5329.png" alt="AC technician checking an air conditioner for warning signs such as weak cooling, water leakage, unusual noise and high energy use" width="1200" height="700" loading="lazy" decoding="async" /></div></section>

<section class="section section--soft"><div class="container why-grid"><div><span class="eyebrow">Why Local Support Matters</span><h2>Service information built around Pune and Mumbai customers.</h2><p>Different buildings, usage patterns and operating conditions can affect AC performance. A local service page helps customers quickly identify their area and the type of support they are looking for.</p></div><div class="why-cards"><article class="card why-card"><b>01</b><h3>Clear Options</h3><p>Understand common AC services before contacting the team.</p></article><article class="card why-card"><b>02</b><h3>City Coverage</h3><p>Dedicated information for Pune and Mumbai service requirements.</p></article><article class="card why-card"><b>03</b><h3>Easy Contact</h3><p>Call, email or use WhatsApp to start your service enquiry.</p></article></div></div></section>

<section class="section home-process"><div class="container"><div class="section-head"><div><span class="eyebrow">Simple Process</span><h2>From enquiry to AC support.</h2></div></div><div class="process-grid"><article><span>01</span><h3>Tell us the requirement</h3><p>Share your city, locality, AC type and the main problem or service needed.</p></article><article><span>02</span><h3>Choose the right service</h3><p>Use the detailed service guide to understand the likely starting point for your enquiry.</p></article><article><span>03</span><h3>Connect with the team</h3><p>Call, email or WhatsApp to discuss the requirement and next steps.</p></article></div></div></section>

<section class="section location-section"><div class="container"><div class="section-head location-head"><div><span class="eyebrow">Service Areas</span><h2>AC service coverage in Pune & Mumbai.</h2><p>Choose your city to explore the local areas and detailed AC service information.</p></div></div><div class="city-area-grid">
<a class="city-area-card" href="/service-areas/mumbai/"><div class="city-area-image"><img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/Mumbai" alt="Mumbai service area" width="900" height="650" loading="lazy" /></div><div class="city-area-content"><span class="city-label">MUMBAI</span><h3>AC Service in Mumbai</h3><p>Explore AC service coverage across Andheri, Bandra, Powai, Borivali, Kandivali, Malad, Goregaon, Vile Parle, Kurla, Ghatkopar, Chembur and Thane.</p><strong>Explore Mumbai Areas <b>→</b></strong></div></a>
<a class="city-area-card" href="/service-areas/pune/"><div class="city-area-image"><img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/Pune" alt="Pune service area" width="900" height="650" loading="lazy" /></div><div class="city-area-content"><span class="city-label">PUNE</span><h3>AC Service in Pune</h3><p>Explore AC service coverage across Baner, Balewadi, Hinjawadi, Wakad, Aundh, Pimple Saudagar, Pimple Nilakh, Pimple Gurav, Ravet and Tathawade.</p><strong>Explore Pune Areas <b>→</b></strong></div></a>
</div></div></section>

<section class="section section--soft"><div class="container faq-preview"><div><span class="eyebrow">Helpful AC Guidance</span><h2>Questions customers often have.</h2></div><div class="faq-list"><details><summary>How often should an AC be serviced?</summary><p>Regular servicing depends on usage, environment and the type of AC. Homes with frequent use can benefit from planned maintenance rather than waiting for performance to drop.</p></details><details><summary>What should I do if my AC is not cooling?</summary><p>Check basic airflow and settings first. If cooling remains weak, a professional inspection can help identify issues involving filters, airflow, drainage, refrigerant or other components.</p></details><details><summary>Do you provide AC support in Pune and Mumbai?</summary><p>Yes. Dedicated Pune and Mumbai service-area pages list the key localities covered by the website.</p></details></div></div></section>
</main>
<CTA /><Footer />
</MainLayout>
<style>
.hero{position:relative;overflow:hidden;background:radial-gradient(circle at 80% 15%,#c9f5f5 0,transparent 35%),linear-gradient(135deg,#f2fbff 0%,#e8f6ff 52%,#dff4f4 100%);color:#092e4b;min-height:clamp(600px,calc(100svh - 88px),800px);display:flex;align-items:center}
.hero-content{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:35px;align-items:center;padding-top:64px;padding-bottom:64px}
.hero-copy{position:relative;z-index:2}.hero .eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 22px;color:#0c6b88;font-size:.82rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.hero .eyebrow:before{content:"";width:28px;height:3px;border-radius:9px;background:#20b6b2}
.hero h1{max-width:700px;margin:0;color:#0a2e4a;font-size:clamp(2.7rem,5.2vw,5rem);font-weight:900;letter-spacing:-.045em;line-height:1.05;text-wrap:balance}.hero h1 span{color:#1689a6}.hero-description{max-width:600px;margin:24px 0 30px;color:#37566c;font-size:clamp(1rem,1.7vw,1.2rem);font-weight:600;line-height:1.8}
.hero-actions{display:flex;flex-wrap:wrap;gap:14px}.hero .btn{display:inline-flex;min-height:54px;align-items:center;justify-content:center;gap:10px;padding:14px 24px;border:1px solid transparent;border-radius:999px;font-weight:850;text-decoration:none;transition:transform .2s ease}.hero .btn:hover{transform:translateY(-2px)}.hero .btn-primary{background:#087a9c;color:#fff;box-shadow:0 10px 28px rgba(8,122,156,.25)}.hero .btn-secondary{border:1px solid #b7d4e3;background:rgba(255,255,255,.72);color:#164661}.hero-trust{display:flex;gap:18px;flex-wrap:wrap;margin-top:24px;color:#327087;font-size:.83rem;font-weight:750}
.hero-visual{position:relative;min-height:480px;display:flex;align-items:center;justify-content:center}.cool-glow{position:absolute;width:430px;height:430px;border-radius:50%;background:radial-gradient(circle,#c5f3f3 0%,rgba(160,225,240,.48) 48%,transparent 72%);filter:blur(2px)}.floating-spark{position:absolute;color:#42b9c3;font-size:2rem}.spark-one{top:35px;right:15%}.spark-two{bottom:42%;left:5%}
.temp-badge{position:absolute;top:25px;right:5%;z-index:2;display:flex;align-items:center;gap:12px;padding:13px 18px;background:#fff;border:1px solid #d8edf2;border-radius:18px;box-shadow:0 12px 35px rgba(20,80,115,.13)}.temp-badge small{display:block;font-size:.62rem;letter-spacing:.12em;color:#6a8796;font-weight:800}.temp-badge strong{font-size:1.8rem;line-height:1;color:#087a9c}.temp-badge sup{font-size:.8rem}.temp-dot{width:10px;height:10px;background:#25c281;border-radius:50%;box-shadow:0 0 0 5px #e5fbf1}.snow{color:#19a8c2;font-size:1.4rem}
.ac-unit{position:relative;width:min(430px,90%);height:145px;margin-top:45px;border-radius:28px;background:linear-gradient(180deg,#fff 0%,#f7fbfd 65%,#e4f0f5 66%,#d5e6ed 100%);box-shadow:0 25px 55px rgba(15,73,110,.17),inset 0 1px 0 #fff;z-index:1}.ac-top{padding:22px 30px;display:flex;justify-content:space-between;align-items:center}.ac-brand{font-weight:900;letter-spacing:.08em;color:#315e77}.ac-brand span{color:#20b6b2}.ac-status{width:9px;height:9px;border-radius:50%;background:#28c580;box-shadow:0 0 0 5px #e6f9ef}.ac-vent{position:absolute;left:8%;right:8%;bottom:22px;height:8px;border-radius:10px;background:repeating-linear-gradient(180deg,#9bb7c5 0 3px,transparent 3px 5px)}.ac-display{position:absolute;right:7%;top:22px;background:#0a587a;color:#ffcc57;border-radius:8px;padding:5px 12px;font-size:1rem;font-weight:900}.air-flow{position:absolute;top:205px;display:flex;gap:34px;z-index:0}.air-flow span{width:4px;height:95px;border-radius:5px;background:linear-gradient(#6dc8dc,transparent);animation:airwave 2.5s ease-in-out infinite}.air-flow span:nth-child(2){animation-delay:.4s}.air-flow span:nth-child(3){animation-delay:.8s}.air-flow span:nth-child(4){animation-delay:1.2s}@keyframes airwave{0%,100%{transform:translateY(0);opacity:.35}50%{transform:translateY(12px);opacity:.85}}
.service-booking{position:absolute;bottom:0;left:2%;right:2%;z-index:3;background:#fff;border:1px solid #d9edf2;border-radius:24px;padding:23px 24px;box-shadow:0 20px 50px rgba(20,75,110,.15)}.service-booking h2{margin:0;color:#153b56;font-size:1.25rem}.service-booking>p{margin:5px 0 16px;color:#6a8292;font-size:.88rem}.service-pills{display:flex;flex-wrap:wrap;gap:9px}.service-pills a{display:inline-flex;gap:5px;align-items:center;padding:10px 13px;border:1px solid #d8e5eb;border-radius:999px;background:#fff;color:#28495c;font-size:.82rem;text-decoration:none;white-space:nowrap}.service-pills a:first-child{background:#0d577a;color:#fff;border-color:#0d577a;font-weight:800}.service-pills b{font-size:.75rem;opacity:.8}.booking-link{display:inline-flex;margin-top:14px;padding:11px 18px;border-radius:999px;background:#17a7a6;color:#fff;font-weight:850;text-decoration:none}.booking-link span{margin-left:8px}
.intro-grid,.feature-grid,.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.intro-grid p:last-child{margin-bottom:0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px}.service-grid{grid-template-columns:repeat(3,1fr);margin-top:34px}.service-card{padding:26px;box-shadow:none}.icon{width:46px;height:46px;display:grid;place-items:center;border-radius:13px;background:var(--blue-light);color:var(--blue);margin-bottom:20px;font-size:1.2rem}.service-card a{color:var(--orange-dark);font-weight:800}.service-card a span{display:inline-block;transition:transform .25s ease}.service-card:hover a span{transform:translateX(5px)}.feature-image{width:100%;max-width:540px;margin-inline:auto}.issue-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:25px}.issue-list span{padding:13px 14px;border:1px solid var(--border);border-radius:12px;background:#fff;font-size:.9rem}.issue-list b{color:var(--orange);margin-right:7px}.why-cards{display:grid;grid-template-columns:1fr;gap:12px}.why-card{padding:22px}.why-card>b{color:var(--orange);font-size:.75rem}.why-card h3{margin-top:10px}.why-card p{margin-bottom:0}.home-process{background:#f7fafc}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.process-grid article{padding:28px;background:#fff;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow)}.process-grid span{color:var(--orange);font-weight:900;font-size:.78rem}.process-grid h3{margin-top:13px}.process-grid p{margin-bottom:0}.location-section{background:#eef4f8}.location-head{margin-bottom:30px}.city-area-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.city-area-card{display:block;overflow:hidden;border:1px solid #cad9e5;border-radius:24px;background:#fff;box-shadow:0 16px 40px rgba(25,59,99,.09);transition:transform .3s ease,box-shadow .3s ease}.city-area-card:hover{transform:translateY(-7px);box-shadow:0 24px 55px rgba(25,59,99,.15)}.city-area-image{height:300px;overflow:hidden;background:#e8f0f5}.city-area-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}.city-area-card:hover .city-area-image img{transform:scale(1.045)}.city-area-content{padding:26px 26px 28px}.city-label{font-size:.73rem;font-weight:900;letter-spacing:.18em;color:var(--orange)}.city-area-content h3{font-size:1.55rem;margin:10px 0 8px;color:var(--navy)}.city-area-content p{font-size:.9rem;margin-bottom:18px}.city-area-content strong{color:var(--orange-dark);font-size:.9rem}.city-area-content strong b{display:inline-block;margin-left:5px;transition:transform .2s ease}.city-area-card:hover .city-area-content strong b{transform:translateX(5px)}.faq-preview{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px}.faq-list{display:grid;gap:10px}.faq-list details{background:#fff;border:1px solid var(--border);border-radius:13px;padding:17px 20px}.faq-list summary{cursor:pointer;font-weight:800;color:var(--navy)}.faq-list p{margin:12px 0 0;font-size:.9rem}
@media(max-width:850px){.hero-content{grid-template-columns:1fr;gap:25px}.hero-copy{text-align:center}.hero .eyebrow,.hero-actions,.hero-trust{justify-content:center}.hero h1,.hero-description{margin-inline:auto}.hero-visual{min-height:480px}.intro-grid,.feature-grid,.why-grid,.faq-preview{grid-template-columns:1fr;gap:40px}.process-grid{grid-template-columns:1fr 1fr}.city-area-grid{grid-template-columns:1fr}.city-area-image{height:270px}}
@media(max-width:560px){.service-grid,.issue-list,.process-grid{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.hero-content{padding:44px 20px 38px}.hero h1{font-size:clamp(2.35rem,10vw,3.4rem)}.hero-description{margin:18px auto 25px;font-size:1rem;line-height:1.65}.hero-actions{display:grid;grid-template-columns:1fr;gap:12px;width:100%;max-width:340px;margin:auto}.hero .btn{width:100%;min-height:52px;padding:14px 18px}.hero-trust{font-size:.76rem;gap:10px}.hero-visual{min-height:430px;margin:0 -5px}.cool-glow{width:340px;height:340px}.temp-badge{top:5px;right:3%;padding:10px 12px}.ac-unit{width:94%;height:125px;margin-top:25px}.air-flow{top:175px;gap:25px}.air-flow span{height:70px}.service-booking{left:0;right:0;bottom:0;padding:18px 16px;border-radius:21px}.service-booking h2{font-size:1.1rem}.service-pills{gap:7px}.service-pills a{font-size:.75rem;padding:9px 11px}.booking-link{padding:10px 16px}.city-area-image{height:220px}}
@media(prefers-reduced-motion:reduce){.hero .btn,.air-flow span{transition:none;animation:none}}
</style>
