---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="Maharashtra AC Service & Repair | Pune & Mumbai" description="Professional AC service, repair, installation and maintenance across Pune and Mumbai.">
<Header />
<main>
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">Pune & Mumbai AC Experts</span><h1>Reliable AC Service. <span>Comfort You Can Count On.</span></h1><p class="lead">Professional air conditioner service, repair, installation and maintenance for homes, offices and commercial spaces.</p><div class="actions"><a class="btn btn--primary" href="tel:+919021803472">Call for AC Service</a><a class="btn btn--secondary" href="/services/">Explore Services</a></div><div class="trust"><span>✓ Skilled technicians</span><span>✓ Transparent service</span><span>✓ Pune & Mumbai coverage</span></div></div><div class="hero-art"><div class="ring ring--orange"></div><div class="ring ring--blue"></div><div class="ac-unit"><span></span><i></i><i></i><i></i><i></i></div><div class="cool-air">❄</div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Our Services</span><h2>Complete AC Care Under One Roof</h2><div class="grid service-grid">{["AC Service","AC Repair","AC Installation","AC Gas Filling","AC Maintenance","AC Uninstallation"].map((service)=><article class="card service-card"><div class="icon">❄</div><h3>{service}</h3><p>Professional support designed to keep your AC efficient and comfortable.</p><a href="/services/">Learn more →</a></article>)}</div></div></section>
<section class="section section--soft"><div class="container location-grid"><div><span class="eyebrow">Service Areas</span><h2>Serving Pune & Mumbai</h2><p>Local AC support with dedicated service-area information for customers across both cities.</p><div class="actions"><a class="btn btn--primary" href="/service-areas/pune/">AC Service in Pune</a><a class="btn btn--secondary" href="/service-areas/mumbai/">AC Service in Mumbai</a></div></div><div class="location-card"><strong>MAHARASHTRA</strong><span>AC SERVICE & REPAIR</span><small>PUNE • MUMBAI</small></div></div></section>
</main>
<CTA /><Footer />
</MainLayout>
<style>
.hero{overflow:hidden;padding:95px 0 80px;background:radial-gradient(circle at 75% 30%,#eaf5ff,transparent 34%),linear-gradient(180deg,#fff,#f7f9fc)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:50px}
.hero h1 span{color:var(--orange)}.lead{max-width:650px;font-size:1.12rem}
.actions{display:flex;gap:12px;flex-wrap:wrap}.trust{display:flex;gap:20px;flex-wrap:wrap;margin-top:26px;color:var(--navy);font-size:.85rem;font-weight:700}
.hero-art{min-height:390px;position:relative;display:grid;place-items:center}.ring{position:absolute;border-radius:50%;border:16px solid}
.ring--orange{width:350px;height:350px;border-color:var(--orange) transparent transparent transparent;transform:rotate(-25deg)}
.ring--blue{width:320px;height:320px;border-color:var(--navy) transparent transparent transparent;transform:rotate(155deg)}
.ac-unit{position:relative;z-index:2;width:min(390px,85%);height:145px;border:2px solid #c9d2df;border-radius:18px 18px 30px 30px;background:#fff;box-shadow:0 24px 50px rgba(11,46,99,.18)}
.ac-unit span{position:absolute;left:12%;right:12%;top:45%;height:6px;background:#dce3eb;border-radius:10px}
.ac-unit i{position:relative;display:inline-block;width:14%;height:7px;margin:90px 1.3%;background:var(--blue);border-radius:0 0 12px 12px}
.cool-air{position:absolute;z-index:1;bottom:25px;font-size:4rem;color:var(--blue);opacity:.75}
.service-grid{grid-template-columns:repeat(3,1fr);margin-top:34px}.service-card{padding:26px;box-shadow:none}.icon{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--blue-light);color:var(--blue);margin-bottom:20px}.service-card a{color:var(--orange-dark);font-weight:800}
.location-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.location-card{min-height:300px;border-radius:28px;background:var(--navy);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:var(--shadow)}.location-card strong{font-size:2.5rem;letter-spacing:.04em}.location-card span{color:var(--orange);font-weight:800}.location-card small{margin-top:20px;color:#c8d6e8;letter-spacing:.18em}
@media(max-width:850px){.hero-grid,.location-grid{grid-template-columns:1fr}.hero-art{min-height:330px}.service-grid{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.service-grid{grid-template-columns:1fr}.hero{padding-top:65px}.hero-art{min-height:270px}.ring--orange{width:270px;height:270px}.ring--blue{width:245px;height:245px}}
</style>