---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
---
<MainLayout title="Maharashtra AC Service & Repair | Pune & Mumbai" description="Professional AC service, repair, installation and maintenance across Pune and Mumbai.">
<Header />
<main>
<section class="hero"><div class="container hero-grid">
  <div class="hero-copy reveal">
    <span class="eyebrow">Pune & Mumbai AC Experts</span>
    <h1>Reliable AC Service.<br /><span>Comfort You Can Count On.</span></h1>
    <p class="lead">Professional air conditioner service, repair, installation and maintenance for homes, offices and commercial spaces.</p>
    <div class="actions"><a class="btn btn--primary" href="tel:+919021803472">Call for AC Service <span>↗</span></a><a class="btn btn--secondary" href="/services/">Explore Services</a></div>
    <div class="trust"><span>✓ Skilled technicians</span><span>✓ Transparent service</span><span>✓ Pune & Mumbai coverage</span></div>
  </div>
  <div class="hero-art reveal delay-2" aria-hidden="true">
    <div class="orb orb--orange"></div><div class="orb orb--blue"></div>
    <div class="ac-unit"><span></span><i></i><i></i><i></i><i></i></div>
    <div class="cool-air">✦</div>
    <div class="float-badge">Fast <strong>AC Support</strong></div>
  </div>
</div></section>

<section class="section"><div class="container">
  <div class="section-head reveal"><div><span class="eyebrow">Our Services</span><h2>Complete AC Care Under One Roof</h2></div><a class="text-link" href="/services/">View all services →</a></div>
  <div class="grid service-grid">
    {[
      ["❄","AC Service","Cleaning, inspection and performance checks."],
      ["⚙","AC Repair","Troubleshooting for cooling, noise and leakage issues."],
      ["＋","AC Installation","Professional split and AC installation support."],
      ["◌","AC Gas Service","Inspection and refrigerant-related support."],
      ["✓","AC Maintenance","Preventive care for homes and workplaces."],
      ["↗","AC Uninstallation","Safe removal and preparation for relocation."]
    ].map(([icon,service,text],i)=><article class={"card service-card reveal delay-"+((i%3)+1)}><div class="icon">{icon}</div><h3>{service}</h3><p>{text}</p><a href="/services/">Learn more <span>→</span></a></article>)}
  </div>
</div></section>

<section class="section visual-section"><div class="container visual-grid">
  <div class="visual-copy reveal"><span class="eyebrow">Built for Local Service</span><h2>Fast support for Pune & Mumbai.</h2><p>Whether it is a routine service, unexpected cooling problem or new installation, get clear service information and a simple path to booking.</p><div class="mini-points"><span><b>01</b> Home & office service</span><span><b>02</b> Repair & maintenance</span><span><b>03</b> Installation support</span></div></div>
  <img class="feature-image reveal delay-2" src="/images/ac-service-pune.svg" alt="Professional AC service illustration for Pune" width="1200" height="700" loading="lazy" decoding="async" />
</div></section>

<section class="section section--soft"><div class="container location-grid">
  <div class="reveal"><span class="eyebrow">Service Areas</span><h2>Serving Pune & Mumbai</h2><p>Explore dedicated service-area information for customers across Pune and Mumbai.</p><div class="actions"><a class="btn btn--primary" href="/service-areas/pune/">AC Service in Pune</a><a class="btn btn--secondary" href="/service-areas/mumbai/">AC Service in Mumbai</a></div></div>
  <div class="location-card reveal delay-2"><strong>MAHARASHTRA</strong><span>AC SERVICE &amp; REPAIR</span><small>PUNE • MUMBAI</small><div class="location-glow"></div></div>
</div></section>
</main>
<CTA /><Footer />
</MainLayout>
<style>
.hero{overflow:hidden;padding:92px 0 78px;background:radial-gradient(circle at 75% 28%,#eaf5ff,transparent 34%),linear-gradient(180deg,#fff,#f7f9fc)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:50px}.hero h1{font-size:clamp(3rem,6vw,5.3rem);margin-top:18px}.hero h1 span{color:var(--orange)}.lead{max-width:650px;font-size:1.08rem}.actions{display:flex;gap:12px;flex-wrap:wrap}.trust{display:flex;gap:20px;flex-wrap:wrap;margin-top:26px;color:var(--navy);font-size:.83rem;font-weight:800}
.hero-art{min-height:410px;position:relative;display:grid;place-items:center}.orb{position:absolute;border-radius:50%;border:16px solid}.orb--orange{width:350px;height:350px;border-color:var(--orange) transparent transparent transparent;transform:rotate(-25deg);animation:spin-slow 16s linear infinite}.orb--blue{width:320px;height:320px;border-color:var(--navy) transparent transparent transparent;transform:rotate(155deg);animation:spin-slow-reverse 18s linear infinite}
.ac-unit{position:relative;z-index:2;width:min(390px,85%);height:145px;border:2px solid #c9d2df;border-radius:18px 18px 30px 30px;background:#fff;box-shadow:0 24px 50px rgba(11,46,99,.18);transition:transform .35s ease,box-shadow .35s ease}.hero-art:hover .ac-unit{transform:translateY(-8px);box-shadow:0 32px 65px rgba(11,46,99,.22)}
.ac-unit span{position:absolute;left:12%;right:12%;top:45%;height:6px;background:#dce3eb;border-radius:10px}.ac-unit i{position:relative;display:inline-block;width:14%;height:7px;margin:90px 1.3%;background:var(--blue);border-radius:0 0 12px 12px}.cool-air{position:absolute;z-index:1;bottom:28px;font-size:4rem;color:var(--blue);opacity:.75;animation:float 3.5s ease-in-out infinite}.float-badge{position:absolute;right:0;bottom:55px;z-index:3;background:#fff;border:1px solid var(--border);box-shadow:var(--shadow);border-radius:16px;padding:12px 16px;font-size:.76rem;color:var(--muted)}.float-badge strong{display:block;color:var(--navy);font-size:.9rem}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px}.text-link{color:var(--orange-dark);font-weight:800}.service-grid{grid-template-columns:repeat(3,1fr);margin-top:34px}.service-card{padding:26px;box-shadow:none}.icon{width:46px;height:46px;display:grid;place-items:center;border-radius:13px;background:var(--blue-light);color:var(--blue);margin-bottom:20px;font-size:1.2rem;transition:transform .3s ease,background .3s ease}.service-card:hover .icon{transform:rotate(-6deg) scale(1.08);background:#dcedfc}.service-card a{color:var(--orange-dark);font-weight:800}.service-card a span{display:inline-block;transition:transform .25s ease}.service-card:hover a span{transform:translateX(5px)}
.visual-section{background:#fff}.visual-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:center}.visual-copy h2{margin-top:14px}.mini-points{display:grid;gap:12px;margin-top:28px}.mini-points span{display:flex;align-items:center;gap:12px;font-weight:700;color:var(--navy)}.mini-points b{font-size:.72rem;color:var(--orange)}.feature-image{width:100%;border-radius:28px;box-shadow:var(--shadow);border:1px solid var(--border)}
.location-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.location-card{min-height:320px;border-radius:28px;background:var(--navy);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:var(--shadow);position:relative;overflow:hidden}.location-card strong{font-size:2.5rem;letter-spacing:.04em;position:relative;z-index:2}.location-card span{color:var(--orange);font-weight:800;position:relative;z-index:2}.location-card small{margin-top:20px;color:#c8d6e8;letter-spacing:.18em;position:relative;z-index:2}.location-glow{position:absolute;width:260px;height:260px;border-radius:50%;border:1px solid rgba(255,255,255,.15);box-shadow:0 0 0 45px rgba(255,255,255,.03),0 0 0 90px rgba(255,255,255,.02)}
@keyframes float{50%{transform:translateY(-10px)}}@keyframes spin-slow{to{transform:rotate(335deg)}}@keyframes spin-slow-reverse{to{transform:rotate(-205deg)}}
@media(max-width:850px){.hero-grid,.visual-grid,.location-grid{grid-template-columns:1fr}.hero-art{min-height:340px}.service-grid{grid-template-columns:1fr 1fr}.section-head{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.service-grid{grid-template-columns:1fr}.hero{padding-top:65px}.hero h1{font-size:clamp(2.55rem,13vw,3.5rem)}.hero-art{min-height:285px}.orb--orange{width:270px;height:270px}.orb--blue{width:245px;height:245px}.float-badge{right:4px;bottom:25px}}
</style>
