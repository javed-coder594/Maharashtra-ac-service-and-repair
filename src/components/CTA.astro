---
interface Props { title?:string; text?:string; }
const { title="Need AC Service or Repair?", text="Book professional AC support for your home or business across Pune and Mumbai." } = Astro.props;
---
<section class="cta"><div class="container cta-wrap"><div class="cta-orbit" aria-hidden="true"></div><div class="cta-copy"><span class="eyebrow">Ready When You Need Us</span><h2>{title}</h2><p>{text}</p><div class="cta-points"><span>✓ Pune & Mumbai coverage</span><span>✓ Home & business support</span><span>✓ Call or WhatsApp</span></div></div><div class="cta-action"><div class="cta-action-label">AC SERVICE &amp; REPAIR</div><a class="cta-main-btn" href="tel:+917378351743">Call 73783 51743 <span>↗</span></a><a class="cta-link" href="/contact/">Or send a service enquiry →</a></div></div></section>
<style>
.cta{padding:86px 0;background:linear-gradient(135deg,#f47a00 0%,#ff9a32 48%,#ffd18d 100%);position:relative;overflow:hidden}.cta:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 8% 20%,rgba(255,255,255,.28),transparent 24%),radial-gradient(circle at 88% 80%,rgba(7,31,67,.14),transparent 30%);pointer-events:none}.cta-wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .8fr;gap:55px;align-items:center}.cta-copy{max-width:700px}.cta .eyebrow{color:#17314f}.cta .eyebrow:before{background:#17314f}.cta h2{color:#071f43;font-size:clamp(2.1rem,4vw,3.3rem);margin-top:10px}.cta p{color:#17314f;max-width:650px;font-size:1.03rem}.cta-points{display:flex;flex-wrap:wrap;gap:9px}.cta-points span{padding:8px 12px;border:1px solid rgba(7,31,67,.14);border-radius:999px;background:rgba(255,255,255,.28);color:#17314f;font-size:.78rem;font-weight:800}.cta-action{padding:28px;border-radius:24px;background:rgba(7,31,67,.94);box-shadow:0 24px 55px rgba(7,31,67,.22);text-align:center}.cta-action-label{color:#ffad67;font-size:.7rem;font-weight:900;letter-spacing:.16em;margin-bottom:13px}.cta-main-btn{display:flex;align-items:center;justify-content:center;gap:9px;padding:15px 20px;border-radius:999px;background:#fff;color:#17314f;font-weight:900;transition:transform .25s ease,box-shadow .25s ease}.cta-main-btn:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.2)}.cta-link{display:block;color:#d9e5f0;font-size:.78rem;font-weight:800;margin-top:15px}.cta-link:hover{color:#fff}.cta-orbit{position:absolute;width:340px;height:340px;border:1px solid rgba(7,31,67,.12);border-radius:50%;right:-190px;top:-210px;box-shadow:0 0 0 45px rgba(255,255,255,.07),0 0 0 90px rgba(255,255,255,.04)}@media(max-width:720px){.cta-wrap{grid-template-columns:1fr;gap:30px}.cta-action{max-width:480px;width:100%}}
</style>