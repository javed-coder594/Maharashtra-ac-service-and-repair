---
interface Props { title?:string; text?:string; }
const { title="Need AC Service or Repair?", text="Book professional AC support for your home or business across Pune and Mumbai." } = Astro.props;
---
<section class="cta">
  <div class="container cta-inner">
    <div class="cta-copy"><span class="eyebrow">Fast AC Support</span><h2>{title}</h2><p>{text}</p></div>
    <div class="actions"><a class="btn btn--primary" href="tel:+917378351743">Call Now <span>↗</span></a><a class="btn btn--secondary" href="/contact/">Book Service</a></div>
  </div>
</section>
<style>
.cta{padding:82px 0;background:radial-gradient(circle at 90% 20%,rgba(244,122,0,.16),transparent 28%),linear-gradient(135deg,var(--navy-dark),var(--navy));position:relative;overflow:hidden}
.cta:after{content:"";position:absolute;width:260px;height:260px;border:1px solid rgba(255,255,255,.1);border-radius:50%;left:-120px;bottom:-150px;box-shadow:0 0 0 45px rgba(255,255,255,.025)}
.cta-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:40px}.cta-copy{max-width:700px}
.cta h2{color:#fff;margin-top:10px}.cta p{color:#c6d3e4;max-width:620px}.actions{display:flex;gap:12px;flex-wrap:wrap}
.cta .btn--secondary{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#fff}
@media(max-width:700px){.cta-inner{flex-direction:column;align-items:flex-start}}
</style>