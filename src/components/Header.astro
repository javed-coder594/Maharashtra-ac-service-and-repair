---
const navItems = [
  { label:"Home", href:"/" }, { label:"About", href:"/about/" }, { label:"Services", href:"/services/" },
  { label:"Service Areas", href:"/service-areas/" }, { label:"Blog", href:"/blog/" }, { label:"Contact", href:"/contact/" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Maharashtra AC Service & Repair home">
      <img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/9cbcc38f-3e63-498a-895a-f8f9dede4341_1" alt="Maharashtra AC Service & Repair" width="220" height="70" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item)=>{const active=item.href === "/" ? currentPath === "/" : currentPath === item.href.replace(/\/$/,"") || currentPath.startsWith(item.href.replace(/\/$/,"") + "/"); return <a class:list={{active}} href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>})}
    </nav>
    <a class="header-call" href="tel:+917378351743"><span>Call</span> 73783 51743 <b>↗</b></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
  </div>
  <div class="mobile-nav" data-mobile-nav><div class="container mobile-nav-inner">
    {navItems.map((item)=>{const active=item.href === "/" ? currentPath === "/" : currentPath === item.href.replace(/\/$/,"") || currentPath.startsWith(item.href.replace(/\/$/,"") + "/"); return <a class:list={{active}} href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>})}
    <a class="mobile-call" href="tel:+917378351743">Call 73783 51743</a>
  </div></div>
</header>
<script>
const initMenu=()=>{const button=document.querySelector(".menu-toggle");const menu=document.querySelector("[data-mobile-nav]");if(!button||!menu||button.dataset.ready)return;button.dataset.ready="true";button.addEventListener("click",()=>{const open=menu.classList.toggle("is-open");button.setAttribute("aria-expanded",String(open));button.setAttribute("aria-label",open?"Close navigation":"Open navigation");});menu.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>menu.classList.remove("is-open")));};
document.addEventListener("astro:page-load",initMenu); initMenu();
</script>
<style>
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);border-bottom:1px solid #dce6ef;backdrop-filter:blur(16px);box-shadow:0 6px 24px rgba(30,70,110,.07)}
.header-inner{min-height:88px;display:flex;align-items:center;gap:24px}.brand{display:flex;align-items:center;margin-right:auto;line-height:0;width:220px}.brand img{display:block;width:220px;height:auto;max-height:76px;object-fit:contain;transition:transform .3s ease,filter .3s ease}.brand:hover img{transform:scale(1.02);filter:drop-shadow(0 7px 12px rgba(22,119,200,.12))}
.desktop-nav{display:flex;align-items:center;gap:4px}.desktop-nav a{position:relative;padding:10px 12px;border-radius:10px;font-size:.88rem;font-weight:800;color:#42536a;transition:color .2s ease,background .2s ease,transform .2s ease}.desktop-nav a:after{content:"";position:absolute;left:12px;right:12px;bottom:4px;height:2px;border-radius:3px;background:var(--orange);transform:scaleX(0);transform-origin:center;transition:transform .2s ease}.desktop-nav a:hover{color:var(--navy);background:#eef6fd;transform:translateY(-1px)}.desktop-nav a.active{color:var(--navy);background:#eaf5ff}.desktop-nav a.active:after{transform:scaleX(1)}
.header-call,.mobile-call{padding:11px 17px;border-radius:999px;background:var(--orange);color:#fff;font-weight:850;font-size:.84rem;white-space:nowrap;transition:transform .25s ease,box-shadow .25s ease,background .2s ease}.header-call:hover,.mobile-call:hover{transform:translateY(-2px);background:var(--orange-dark);box-shadow:0 10px 25px rgba(244,122,0,.25)}.header-call span{opacity:.8}.header-call b{margin-left:4px}
.menu-toggle{display:none;border:1px solid #cbd9e6;background:#f4f8fc;font-size:1.35rem;color:var(--navy);border-radius:10px;cursor:pointer;padding:6px 10px}
.mobile-nav{display:none;border-top:1px solid #e1e9f0;background:#fff}.mobile-nav-inner{padding:10px 18px 18px;display:grid;gap:3px}.mobile-nav a{padding:12px 13px;border-radius:9px;font-weight:800;color:#42536a}.mobile-nav a:hover{background:#eef6fd;color:var(--navy)}.mobile-nav a.active{background:#eaf5ff;color:var(--navy);border-left:3px solid var(--orange)}.mobile-nav .mobile-call{text-align:center;color:#fff;margin-top:8px;background:var(--orange)}.mobile-nav.is-open{display:block}
@media(max-width:1100px){.brand{width:200px}.brand img{width:200px}.desktop-nav{gap:2px}.desktop-nav a{padding-inline:8px}}
@media(max-width:980px){.header-inner{min-height:78px}.brand{width:180px}.brand img{width:180px}.desktop-nav{display:none}.menu-toggle{display:block}.header-call{display:none}}
</style>