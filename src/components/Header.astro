---
const navItems = [
  { label:"Home", href:"/" }, { label:"About", href:"/about/" }, { label:"Services", href:"/services/" },
  { label:"Service Areas", href:"/service-areas/" }, { label:"Blog", href:"/blog/" }, { label:"Contact", href:"/contact/" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Maharashtra AC Service & Repair home">
      <img src="https://res.cloudinary.com/mnqvmnca/image/upload/f_auto,q_auto/9cbcc38f-3e63-498a-895a-f8f9dede4341_1" alt="Maharashtra AC Service & Repair" width="220" height="70" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navItems.map((item)=>{const active=item.href === "/" ? currentPath === "/" : currentPath === item.href.replace(/\/$/,"") || currentPath.startsWith(item.href.replace(/\/$/,"") + "/"); return <a class:list={{active}} href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>})}
    </nav>
    <a class="header-call" href="tel:+917378351743">Call 73783 51743 <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
  </div>
  <div class="mobile-nav" data-mobile-nav><div class="container mobile-nav-inner">
    {navItems.map((item)=>{const active=item.href === "/" ? currentPath === "" : currentPath === item.href.replace(/\/$/,"") || currentPath.startsWith(item.href.replace(/\/$/,"") + "/"); return <a class:list={{active}} href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>})}
    <a class="mobile-call" href="tel:+917378351743">Call 73783 51743</a>
  </div></div>
</header>
<script>
const initMenu=()=>{const button=document.querySelector(".menu-toggle");const menu=document.querySelector("[data-mobile-nav]");if(!button||!menu||button.dataset.ready)return;button.dataset.ready="true";button.addEventListener("click",()=>{const open=menu.classList.toggle("is-open");button.setAttribute("aria-expanded",String(open));button.setAttribute("aria-label",open?"Close navigation":"Open navigation");});menu.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>menu.classList.remove("is-open")));};
document.addEventListener("astro:page-load",initMenu); initMenu();
</script>
<style>
.site-header{position:sticky;top:0;z-index:50;background:rgba(7,31,67,.97);border-bottom:1px solid rgba(255,255,255,.1);backdrop-filter:blur(14px);box-shadow:0 10px 30px rgba(4,18,40,.18)}
.header-inner{min-height:88px;display:flex;align-items:center;gap:24px}.brand{display:flex;align-items:center;margin-right:auto;line-height:0;width:220px}.brand img{display:block;width:220px;height:auto;max-height:76px;object-fit:contain;transition:transform .3s ease,filter .3s ease}.brand:hover img{transform:scale(1.02);filter:drop-shadow(0 7px 12px rgba(255,255,255,.12))}
.desktop-nav{display:flex;align-items:center;gap:7px}.desktop-nav a{position:relative;padding:9px 12px;border-radius:9px;font-size:.88rem;font-weight:800;color:#d9e5f2;transition:color .2s ease,background .2s ease,transform .2s ease}.desktop-nav a:hover{color:#fff;background:rgba(255,255,255,.08);transform:translateY(-1px)}.desktop-nav a.active{color:#fff;background:var(--orange);box-shadow:0 7px 18px rgba(244,122,0,.2)}.desktop-nav a.active:hover{background:var(--orange-dark)}
.header-call,.mobile-call{padding:11px 17px;border-radius:999px;background:var(--orange);color:#fff;font-weight:850;font-size:.84rem;white-space:nowrap;transition:transform .25s ease,box-shadow .25s ease,background .2s ease}.header-call:hover,.mobile-call:hover{transform:translateY(-2px);background:var(--orange-dark);box-shadow:0 10px 25px rgba(244,122,0,.3)}
.menu-toggle{display:none;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);font-size:1.45rem;color:#fff;border-radius:10px;cursor:pointer;padding:6px 10px}
.mobile-nav{display:none;border-top:1px solid rgba(255,255,255,.1);background:var(--navy-dark)}.mobile-nav-inner{padding:10px 18px 18px;display:grid;gap:3px}.mobile-nav a{padding:12px 13px;border-radius:9px;font-weight:800;color:#d9e5f2}.mobile-nav a:hover{background:rgba(255,255,255,.08);color:#fff}.mobile-nav a.active{background:rgba(244,122,0,.18);color:#ffad67;border-left:3px solid var(--orange)}.mobile-nav .mobile-call{text-align:center;color:#fff;margin-top:8px;background:var(--orange)}.mobile-nav.is-open{display:block}
@media(max-width:1100px){.brand{width:200px}.brand img{width:200px}.desktop-nav{gap:3px}.desktop-nav a{padding-inline:9px}}
@media(max-width:980px){.header-inner{min-height:78px}.brand{width:180px}.brand img{width:180px}.desktop-nav{display:none}.menu-toggle{display:block}.header-call{display:none}}
</style>