---
const navItems = [
  { label:"Home", href:"/" }, { label:"About", href:"/about/" }, { label:"Services", href:"/services/" },
  { label:"Service Areas", href:"/service-areas/" }, { label:"Blog", href:"/blog/" }, { label:"Contact", href:"/contact/" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const servicesActive = currentPath === "/services" || currentPath.startsWith("/services/");
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Maharashtra AC Service & Repair home"><img src="/images/maharashtra-ac-logo.svg" alt="Maharashtra AC Service & Repair" width="240" height="75" /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class:list={{active:currentPath === "/"}} href="/">Home</a><a class:list={{active:currentPath === "/about" || currentPath.startsWith("/about/")}} href="/about/">About</a>
      <a class:list={{active:servicesActive}} href="/services/">Services</a><a class:list={{active:currentPath === "/service-areas" || currentPath.startsWith("/service-areas/")}} href="/service-areas/">Service Areas</a>
      <a class:list={{active:currentPath === "/blog" || currentPath.startsWith("/blog/")}} href="/blog/">Blog</a><a class:list={{active:currentPath === "/contact" || currentPath.startsWith("/contact/")}} href="/contact/">Contact</a>
    </nav>
    <a class="header-call" href="tel:+917378351743" aria-label="Call Maharashtra AC Service & Repair">Call Now <b>↗</b></a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
  </div>
  <div class="mobile-nav" data-mobile-nav><div class="container mobile-nav-inner">
    <a class:list={{active:currentPath === "/"}} href="/">Home</a><a class:list={{active:currentPath === "/about" || currentPath.startsWith("/about/")}} href="/about/">About</a><a class:list={{active:servicesActive}} href="/services/">Services</a>
    <a class:list={{active:currentPath === "/service-areas" || currentPath.startsWith("/service-areas/")}} href="/service-areas/">Service Areas</a><a class:list={{active:currentPath === "/blog" || currentPath.startsWith("/blog/")}} href="/blog/">Blog</a><a class:list={{active:currentPath === "/contact" || currentPath.startsWith("/contact/")}} href="/contact/">Contact</a>
    <a class="mobile-call" href="tel:+917378351743" aria-label="Call Maharashtra AC Service & Repair">Call Now</a>
  </div></div>
</header>
<script>
const initMenu=()=>{const button=document.querySelector(".menu-toggle");const menu=document.querySelector("[data-mobile-nav]");if(!button||!menu||button.dataset.ready)return;button.dataset.ready="true";button.addEventListener("click",()=>{const open=menu.classList.toggle("is-open");button.setAttribute("aria-expanded",String(open));button.setAttribute("aria-label",open?"Close navigation":"Open navigation");});menu.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>menu.classList.remove("is-open")));};
document.addEventListener("astro:page-load",initMenu);initMenu();
</script>
<style>
.site-header{position:sticky;top:0;z-index:50;width:100%;background:rgba(255,255,255,.97);border-bottom:1px solid #dce6ef;backdrop-filter:blur(16px);box-shadow:0 6px 24px rgba(30,70,110,.07)}
.header-inner{min-height:88px;display:flex;align-items:center;gap:24px;min-width:0}.brand{display:flex;align-items:center;margin-right:auto;line-height:0;width:220px;height:76px;flex:0 0 220px}.brand img{display:block;width:220px;height:69px;object-fit:contain;object-position:left center}.desktop-nav{display:flex;align-items:center;gap:2px;min-width:0}.desktop-nav>a{position:relative;padding:10px 10px;border-radius:10px;font-size:.84rem;font-weight:800;color:#42536a;white-space:nowrap}.desktop-nav>a:hover,.desktop-nav>a.active{color:var(--navy);background:#eaf5ff}.desktop-nav>a.active:after{content:"";position:absolute;left:10px;right:10px;bottom:4px;height:2px;border-radius:3px;background:var(--orange)}
.header-call,.mobile-call{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:11px 18px;border-radius:999px;background:var(--orange);color:#fff;font-weight:850;font-size:.84rem;white-space:nowrap;transition:transform .25s ease,box-shadow .25s ease}.header-call:hover,.mobile-call:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(244,122,0,.25)}.menu-toggle{display:none;border:1px solid #cbd9e6;background:#f4f8fc;font-size:1.35rem;color:var(--navy);border-radius:10px;cursor:pointer;padding:6px 10px}
.mobile-nav{display:none;border-top:1px solid #e1e9f0;background:#fff}.mobile-nav-inner{padding:10px 14px 18px;display:grid;gap:3px}.mobile-nav a{padding:12px 0;font-weight:750;color:var(--text)}.mobile-nav a.active{color:var(--orange)}.mobile-nav .mobile-call{text-align:center;color:#fff;margin-top:8px}.mobile-nav.is-open{display:block}
@media(max-width:1100px){.header-inner{gap:12px}.brand{width:190px;flex-basis:190px}.brand img{width:190px}.desktop-nav>a{padding-inline:7px;font-size:.8rem}.header-call{padding-inline:13px}}
@media(max-width:980px){.header-inner{min-height:76px}.brand{width:175px;flex-basis:175px;height:64px}.brand img{width:175px;height:60px}.desktop-nav{display:none}.menu-toggle{display:block;margin-left:auto}.header-call{display:none}}
@media(max-width:560px){.header-inner{min-height:70px}.brand{width:155px;flex-basis:155px;height:56px}.brand img{width:155px;height:52px}.menu-toggle{font-size:1.2rem;padding:5px 9px}}
</style>